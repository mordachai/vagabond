              "runAsGM": false
            }
          },
          {
            "level": 1,
            "name": "Footloose",
            "description": "<p>You gain the Fallaway Reverse Perk (p. 68) and, when you make a Reflex Save, roll two d20s and use the higher result.</p>",
            "statBonusPoints": 0,
            "extraTraining": 0,
            "requiredSpells": [],
