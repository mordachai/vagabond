    {
      "name": "Tempo +",
      "type": "spell",
      "img": "icons/magic/time/clock-stopwatch-white-blue.webp",
      "system": {
        "description": "<p><span class=\"fontstyle0\">The Target's Speed increases or decreases by 5' for the duration. The Caster can increase or decrease this amount by 5' by spending additional Mana on the Cast for every 1 Mana spent to do so.</span></p>",
        "damageType": "-",
        "duration": "Until your next turn",
        "crit": "Duration is 1 Minute (no Focus required).",
        "favorite": true,
        "fxSchool": "arcane",
        "usesDiceScaling": true,
        "diceScaleLabel": "Speed",
        "hitMacro": {
          "enabled": true,
          "uuid": "",
          "command": "const amount  = (Number(scope.spellDamageDice ?? 1) || 1) * 5;\nconst targets = scope.targets ?? [];\nif (!targets.length) return ui.notifications.warn(\"Tempo: no target.\");\nconst duration = scope.isCritical ? { seconds: 60 } : {};\nfor (const t of targets) {\n  const a = t.actor ?? t; if (!a) continue;\n  const npc = typeof a.system.speed !== \"object\";\n  await a.createEmbeddedDocuments(\"ActiveEffect\", [{\n    name: `Tempo (+${amount} ft)`,\n    img: \"icons/magic/time/clock-stopwatch-white-blue.webp\",\n    duration,\n    changes: [{ key: npc ? \"system.speed\" : \"system.speed.bonus\", mode: CONST.ACTIVE_EFFECT_MODES.ADD, value: String(amount) }],\n    flags: { vagabond: { tempo: true } },\n  }]);\n}\nui.notifications.info(`Tempo: +${amount} ft on ${targets.length} target(s).`);",
          "label": "Tempo +",
          "runAsGM": true
        },
        "locked": true
      },
      "effects": [],
      "flags": {},
      "_id": "Ms8VO16QnnNx0RLG",
      "_key": "!actors.items!NZbcDOzbvZ8Js4uR.Ms8VO16QnnNx0RLG"
