    {
      "name": "Animate",
      "type": "spell",
      "img": "icons/magic/movement/pinwheel-turning-blue.webp",
      "system": {
        "description": "<p><span class=\"fontstyle0\">You animate up to 1 Slot of Items in the delivery or that are carried by the Target. For the duration, the Item gains a Speed of 30' (Fly), uses the Object Armor &amp; HP rules (p. 10), and uses your Cast Skill for Checks.</span></p><p><span class=\"fontstyle0\">These Items obey your commands, which you can issue when you Focus on this Spell. If you command an Item to take an Action, you must spend 1 Mana to do so for each Item.</span></p><p><strong>Upcast:</strong> You can animate one additional Slot's worth of Item(s) per Mana spent to do so.</p>",
        "damageType": "-",
        "duration": "Until your next turn",
        "crit": "",
        "favorite": true,
        "noRollRequired": true,
        "fxSchool": "genericlight",
        "locked": true
      },
      "effects": [],
      "flags": {},
      "_id": "4faikfLmIwjOUyDn",
      "_key": "!actors.items!h41F2B5x5er9ecuc.4faikfLmIwjOUyDn"
    },
    {
      "name": "Forge",
      "type": "spell",
      "img": "icons/magic/symbols/runes-star-pentagon-orange-purple.webp",
      "system": {
        "description": "<p><span class=\"fontstyle0\">You materialize an Item of 1 Slot or less worth no more than 1g either in an unoccupied space near the Target, worn by the Target, or one Item per 5' cube within the Target area. This magic can create a solid Item made of either copper, iron, glass, stone, or wood. For example, this could create an iron flagon, but not a flagon of ale. If you Target yourself with this Spell, you can Equip the Item when it is created (no Action). Doing so can't cause an Equipped Item to become unequipped. The Item is usable for the duration, then disappears.</span></p>",
        "damageType": "-",
        "duration": "Until your next turn",
        "crit": "",
        "favorite": true,
        "noRollRequired": true,
        "fxSchool": "shadow",
        "locked": true
      },
      "effects": [],
      "flags": {},
      "_id": "hVRif6bltwYfELAH",
      "_key": "!actors.items!h41F2B5x5er9ecuc.hVRif6bltwYfELAH"
    },
    {
      "name": "Knock",
      "type": "spell",
      "img": "icons/sundries/misc/lock-open-yellow.webp",
      "system": {
        "description": "<p><span class=\"fontstyle0\">Opens barred, locked, or stuck chests, doors, and gates that you can sense. It does so with an audible knock that can be heard out to 300'. This affects secret and magic locks and doors, but you must be aware of them to affect them.</span></p>",
        "damageType": "-",
        "duration": "Until your next turn",
        "crit": "",
