        "perkAmount": 0,
        "spellAmount": 0,
        "skillChoices": []
      },
      {
        "level": 2,
        "name": "Haymaker (10+)",
        "description": "<p>If the result of your Brawl Check for an attack exceeds your Difficulty by 10, the Target is Dazed until the start of your Turn. The number needed to exceed is reduced by 1 every 6 Levels hereafter.</p>",
