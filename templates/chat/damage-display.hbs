{{! damage-display.hbs }}
<div class="damage-section{{#if damage.critToggle}} attack-crit-toggle{{/if}}"{{#if damage.critToggle}} data-crit-active="true" data-actor-id="{{actor.uuid}}"{{/if}}>
    <div class="damage-block" title="{{damage.formula}} {{#if (eq damage.typeKey 'healing')}}{{localize 'VAGABOND.UI.Sections.Healing'}}{{else if (eq damage.typeKey 'recover')}}{{localize 'VAGABOND.UI.Sections.Recovery'}}{{else if (eq damage.typeKey 'recharge')}}{{localize 'VAGABOND.UI.Sections.Recharge'}}{{else}}{{localize 'VAGABOND.UI.Sections.Damage'}}{{/if}}">
        {{!-- Total + crit badge (clickable benefit toggle when critToggle) --}}
        <div class="damage-row">
            <div class="damage-total-display" data-dice-toggle role="button" tabindex="0" aria-expanded="false" title="{{localize 'VAGABOND.UI.Labels.ShowDice'}}">
                <i class="{{#if damage.iconClass}}{{damage.iconClass}}{{else}}fas fa-burst{{/if}} damage-bg-icon"></i>
                {{#if damage.critToggle}}
                <div class="crit-state-on">
                    <div class="damage-value">{{damage.total}}</div>
                </div>
                <div class="crit-state-off">
                    <div class="damage-value">{{damage.baseTotal}}</div>
                </div>
                {{else}}
                <div class="damage-value">{{damage.total}}</div>
                {{/if}}
                <i class="fas fa-chevron-down damage-chevron"></i>
            </div>
            {{#if damage.isCritical}}
            <span class="crit-label{{#if damage.critToggle}} attack-crit-toggle-btn{{/if}}"
                {{#if damage.critToggle}}data-action="toggleAttackCritBenefit" title="{{localize 'VAGABOND.DefendMechanics.CritToggleHint'}}"{{/if}}>
                {{localize "VAGABOND.Item.Spell.FIELDS.crit.label"}}!
            </span>
            {{/if}}
        </div>

        {{!-- Dice + modifiers: collapsed until the total is clicked --}}
        <div class="damage-dice-wrap">
            <div class="damage-dice-list">
                 {{{damage.diceDisplay}}}
            </div>
        </div>
    </div>

    {{{damage.defenseHtml}}}
</div>
