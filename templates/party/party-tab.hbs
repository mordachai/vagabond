{{! Party Tab — supplies bar + member card grid }}
<section
  class="tab party scrollable {{tab.cssClass}}"
  data-group="primary"
  data-tab="party"
>

  {{! ── Party Header ─────────────────────────────────────────────────────── }}
  <div class="party-header">
    <div class="party-portrait-wrap">
      {{! Shows what the token shows: party art, or the active transport's art while travelling
          (the party's own art is only editable while it is shown) }}
      <img
        class="party-portrait{{#if tokenMode.travelling}} is-transport{{/if}}"
        src="{{tokenMode.portrait}}"
        alt="{{tokenMode.portraitTooltip}}"
        {{#unless tokenMode.travelling}}data-edit="img" data-action="onEditImage"{{/unless}}
        data-tooltip="{{tokenMode.portraitTooltip}}"
      >
      {{#if editable}}
      <button type="button" class="party-token-mode{{#if tokenMode.transport}} is-transport{{/if}}" data-action="toggleTokenMode" data-tooltip="{{tokenMode.tooltip}}"{{#if tokenMode.disabled}} disabled{{/if}}>
        <i class="fa-solid fa-users{{#unless tokenMode.transport}} is-on{{/unless}}"></i>
        <i class="fa-solid fa-horse{{#if tokenMode.transport}} is-on{{/if}}"></i>
      </button>
      {{/if}}
    </div>
    <div class="party-info">
      <div class="party-name-row">
        <input
          type="text"
          name="name"
          value="{{actor.name}}"
          class="party-name"
          placeholder="{{localize 'VAGABOND.Actor.Party.NamePlaceholder'}}"
        >
        {{#if isGM}}
        <button type="button" class="party-levelup-btn" data-action="partyLevelUpAll" data-tooltip="{{localize 'VAGABOND.Actor.Party.Controls.LevelUpAllTooltip'}}">
          <i class="fas fa-angles-up"></i> {{localize 'VAGABOND.Actor.Party.Controls.LevelUpAll'}}
        </button>
        {{/if}}
      </div>

      {{! Movement grid — row 1: Speed · Crawl · Travel; row 2 (book Exploration):
          Navigator · Pace · Hazardous Lands. Every cell = small label over its value / control. }}
      <div class="party-move">
        <div class="pm-cell party-speed-stat">
          <span class="pm-label">{{localize 'VAGABOND.Actor.Character.FIELDS.combat.speed.base.label'}}</span>
          <span class="pm-value">
            <input type="number" name="system.speed" value="{{speeds.speed.value}}" class="speed-input{{#if speeds.speed.auto}} is-auto{{/if}}" min="0"{{#if speeds.speed.auto}} data-tooltip="{{speeds.autoTooltip}}"{{/if}}>
            <span class="speed-unit">{{localize 'VAGABOND.UI.Units.Feet'}}</span>
          </span>
        </div>
        <div class="pm-cell party-speed-stat">
          <span class="pm-label">{{localize 'VAGABOND.Actor.Character.FIELDS.combat.speed.crawl.label'}}</span>
          <span class="pm-value">
            <input type="number" name="system.crawl" value="{{speeds.crawl.value}}" class="speed-input{{#if speeds.crawl.auto}} is-auto{{/if}}" min="0"{{#if speeds.crawl.auto}} data-tooltip="{{speeds.autoTooltip}}"{{/if}}>
            <span class="speed-unit">{{localize 'VAGABOND.UI.Units.Feet'}}</span>
          </span>
        </div>
        <div class="pm-cell party-speed-stat">
          <span class="pm-label">{{localize 'VAGABOND.Actor.Character.FIELDS.combat.speed.travel.label'}}</span>
          <span class="pm-value">
            {{! Shows the miles this Shift (Pace / Hazardous Lands applied, red outline when altered); focusing it edits the base Travel Speed }}
            {{#if speeds.trip.modified}}
            <input type="number" name="system.travel" value="{{speeds.trip.distance}}" class="speed-input is-modified{{#if speeds.travel.auto}} is-auto{{/if}}" min="0" step="any" data-base="{{speeds.travel.value}}" data-trip="{{speeds.trip.distance}}" data-tooltip="{{speeds.trip.distanceTooltip}}">
            {{else}}
            <input type="number" name="system.travel" value="{{speeds.travel.value}}" class="speed-input{{#if speeds.travel.auto}} is-auto{{/if}}" min="0"{{#if speeds.travel.auto}} data-tooltip="{{speeds.autoTooltip}}"{{/if}}>
            {{/if}}
            <span class="speed-unit">{{localize 'VAGABOND.UI.Units.Miles'}}</span>
          </span>
        </div>

        <div class="pm-row">
          <div class="pm-cell pm-leader" data-tooltip="{{speeds.trip.leaderTooltip}}">
            <span class="pm-label">{{localize 'VAGABOND.Actor.Party.Travel.LabelNavigator'}}</span>
            <span class="pm-value">
              <i class="fa-solid {{#if speeds.trip.leaderRides}}fa-horse{{else}}fa-compass{{/if}}"></i>
              <span class="ptr-leader-name">{{speeds.trip.leader}}</span>
            </span>
          </div>
          <div class="pm-cell pm-pace">
            <span class="pm-label">{{localize 'VAGABOND.Actor.Party.Travel.LabelPace'}}</span>
            <div class="ptr-paces">
              {{#each speeds.trip.paces}}
              <button type="button" class="ptr-pace{{#if active}} is-selected{{/if}}" data-action="setTravelPace" data-pace="{{key}}" data-tooltip="{{tooltip}}">{{label}}</button>
              {{/each}}
            </div>
          </div>
          <div class="pm-cell pm-toggle">
            <span class="pm-label">{{localize 'VAGABOND.Actor.Party.Travel.LabelHazard'}}</span>
            <button type="button" class="ptr-hazard{{#if speeds.trip.hazardous}} is-on{{/if}}" data-action="toggleHazardous" data-tooltip="{{speeds.trip.hazardTooltip}}">
              <i class="fa-solid fa-mountain"></i>
            </button>
          </div>
        </div>
      </div>

      {{! Travel + Downtime Shift clocks, side by side, full header height }}
      <div class="party-clock-boxes">
        <div class="party-clock-box party-travel-box">
          <div class="pdt-clocks" style="--pdt-size: {{travelClocks.size}}px">
            {{#if isGM}}
            <img class="pdt-handle pdt-handle-left" src="systems/vagabond/assets/ui/clocks/clock_left_bt.svg" alt="" data-action="partyTravelStep" data-step="-1" data-tooltip="{{localize 'VAGABOND.Actor.Party.Controls.TravelRemove'}}">
            {{/if}}
            {{#each travelClocks.list}}
            <img class="pdt-clock" src="{{img}}" alt="" data-tooltip="{{tooltip}}">
            {{/each}}
            {{#if isGM}}
            <img class="pdt-handle pdt-handle-right" src="systems/vagabond/assets/ui/clocks/clock_right_bt.svg" alt="" data-action="partyTravelStep" data-step="1" data-tooltip="{{localize 'VAGABOND.Actor.Party.Controls.TravelAdd'}}">
            {{/if}}
          </div>
          <span class="pdt-count-row">
            <span class="pdt-count{{#if travelClocks.over}} is-over{{/if}}" data-tooltip="{{localize 'VAGABOND.Actor.Party.Controls.TravelTooltip'}}">{{localize 'VAGABOND.Actor.Party.Controls.TravelCount' n=travelClocks.travelled}}</span>
            {{#if (and isGM travelClocks.travelled)}}
            <button type="button" class="pdt-reset" data-action="partyTravelReset" data-tooltip="{{localize 'VAGABOND.Actor.Party.Controls.TravelReset'}}"><i class="fa-solid fa-rotate-left"></i></button>
            {{/if}}
          </span>
          {{#if isGM}}
          <button type="button" class="pdt-open" data-action="partyTravel" data-tooltip="{{localize 'VAGABOND.Actor.Party.Controls.TravelGM'}}">{{localize 'VAGABOND.Actor.Party.Controls.Travel'}}</button>
          {{/if}}
        </div>

        <div class="party-clock-box party-downtime-box">
          <div class="pdt-clocks" style="--pdt-size: {{shiftClocks.size}}px">
            {{#if isGM}}
            <img class="pdt-handle pdt-handle-left" src="systems/vagabond/assets/ui/clocks/clock_left_bt.svg" alt="" data-action="partyShiftsStep" data-step="-1" data-tooltip="{{localize 'VAGABOND.Actor.Party.Controls.ShiftsRemove'}}">
            {{/if}}
            {{#each shiftClocks.list}}
            <img class="pdt-clock" src="{{img}}" alt="" data-tooltip="{{tooltip}}">
            {{/each}}
            {{#if isGM}}
            <img class="pdt-handle pdt-handle-right" src="systems/vagabond/assets/ui/clocks/clock_right_bt.svg" alt="" data-action="partyShiftsStep" data-step="1" data-tooltip="{{localize 'VAGABOND.Actor.Party.Controls.ShiftsAdd'}}">
            {{/if}}
          </div>
          <span class="pdt-count" data-tooltip="{{localize 'VAGABOND.Actor.Party.Controls.ShiftsTooltip'}}">{{localize 'VAGABOND.Actor.Party.Controls.ShiftsCount' n=system.shifts}}</span>
          <button
            type="button"
            class="pdt-open"
            data-action="partyDowntime"
            data-tooltip="{{#if isGM}}{{localize 'VAGABOND.Actor.Party.Controls.DowntimeGM'}}{{else}}{{localize 'VAGABOND.Actor.Party.Controls.DowntimeOwn'}}{{/if}}"
          >{{localize 'VAGABOND.Actor.Party.Controls.Downtime'}}</button>
        </div>
      </div>
    </div>
  </div>

  {{! ── Party strip: supplies · treasure · member buttons, one compact row ── }}
  <div class="party-strip">
    <div class="ps-group">
      <span class="ps-chip{{#if supplies.rationsTooltip}} has-breakdown{{/if}}" {{#if supplies.rationsTooltip}}data-tooltip-html="{{supplies.rationsTooltip}}" data-tooltip-direction="DOWN"{{/if}}>
        <img class="ps-icon ps-icon--img" src="icons/consumables/grains/bread-loaf-sliced-wheat-brown.webp" alt="">
        <span class="ps-stack">
          <span class="ps-value">{{supplies.rations}}</span>
          <span class="ps-label">{{localize 'VAGABOND.Actor.Party.Card.Rations'}}</span>
        </span>
      </span>
      <span class="ps-chip{{#if supplies.beveragesTooltip}} has-breakdown{{/if}}" {{#if supplies.beveragesTooltip}}data-tooltip-html="{{supplies.beveragesTooltip}}" data-tooltip-direction="DOWN"{{/if}}>
        <img class="ps-icon ps-icon--img" src="icons/sundries/survival/waterskin-leather-brown.webp" alt="">
        <span class="ps-stack">
          <span class="ps-value">{{supplies.beverages}}</span>
          <span class="ps-label">{{localize 'VAGABOND.Actor.Party.Card.Beverages'}}</span>
        </span>
      </span>
    </div>

    <div class="ps-group ps-treasure">
      {{! Chest = the party's own purse (editable) }}
      <span class="ps-chip" data-tooltip="{{localize 'VAGABOND.Actor.Party.Card.Chest'}}">
        <i class="ps-icon fa-solid fa-treasure-chest"></i>
        <span class="ps-stack">
          <span class="ps-coins">
            <label class="ps-coin"><input type="number" class="ps-coin-input" name="system.currency.gold" value="{{system.currency.gold}}" min="0"{{#unless editable}} readonly{{/unless}}><span class="currency-abbr">{{localize 'VAGABOND.Currency.Gold.abbr'}}</span></label>
            <label class="ps-coin"><input type="number" class="ps-coin-input" name="system.currency.silver" value="{{system.currency.silver}}" min="0"{{#unless editable}} readonly{{/unless}}><span class="currency-abbr">{{localize 'VAGABOND.Currency.Silver.abbr'}}</span></label>
            <label class="ps-coin"><input type="number" class="ps-coin-input" name="system.currency.copper" value="{{system.currency.copper}}" min="0"{{#unless editable}} readonly{{/unless}}><span class="currency-abbr">{{localize 'VAGABOND.Currency.Copper.abbr'}}</span></label>
          </span>
          <span class="ps-label">{{localize 'VAGABOND.Actor.Party.Card.ChestLabel'}}</span>
        </span>
      </span>
      {{! Wealth = members' coins + the transports' Holds, summed (GM: hover for the breakdown) }}
      <span class="ps-chip{{#if supplies.currencyTooltip}} has-breakdown{{/if}}" {{#if supplies.currencyTooltip}}data-tooltip-html="{{supplies.currencyTooltip}}" data-tooltip-direction="DOWN"{{else}}data-tooltip="{{localize 'VAGABOND.Actor.Party.Card.TotalWealth'}}"{{/if}}>
        <i class="ps-icon fas fa-coins"></i>
        <span class="ps-stack">
          <span class="ps-coins">
            <span class="ps-coin">{{supplies.currency.gold}}<span class="currency-abbr">{{localize 'VAGABOND.Currency.Gold.abbr'}}</span></span>
            <span class="ps-coin">{{supplies.currency.silver}}<span class="currency-abbr">{{localize 'VAGABOND.Currency.Silver.abbr'}}</span></span>
            <span class="ps-coin">{{supplies.currency.copper}}<span class="currency-abbr">{{localize 'VAGABOND.Currency.Copper.abbr'}}</span></span>
          </span>
          <span class="ps-label">{{localize 'VAGABOND.Actor.Party.Card.Wealth'}}</span>
        </span>
      </span>
    </div>

    <div class="ps-actions">
      {{#if partyOwnershipNote}}
      <span class="ps-ownership" data-tooltip="{{partyOwnershipNote}}">
        <i class="fa-solid fa-triangle-exclamation"></i>
      </span>
      {{/if}}
      {{#if isGM}}
      <button type="button" class="ps-btn" data-action="openCompactView" data-tooltip="{{localize 'VAGABOND.Actor.Party.CompactView.Open'}}">
        <i class="fas fa-table-columns"></i>
      </button>
      {{/if}}
      <button type="button" class="ps-btn" data-action="openMemberPicker" data-tooltip="{{localize 'VAGABOND.Actor.Party.Card.AddMember'}}">
        <i class="fas fa-user-plus"></i>
      </button>
      <button type="button" class="ps-btn ps-btn--remove" data-action="toggleRemoveMode" data-tooltip="{{localize 'VAGABOND.Actor.Party.Card.RemoveMember'}}">
        <i class="fas fa-user-minus"></i>
      </button>
    </div>
  </div>

  {{! ── Member Card Grid ───────────────────────────────── }}
  {{#if members.length}}
    <div class="party-member-grid" style="--member-count: {{members.length}}">
      {{#each members}}
        {{#if isNPC}}
          {{> "systems/vagabond/templates/party/party-npc-card.hbs" config=../config}}
        {{else}}
          {{> "systems/vagabond/templates/party/party-member-card.hbs"}}
        {{/if}}
      {{/each}}
    </div>
  {{else}}
    <div class="party-empty-state">
      <p>{{localize 'VAGABOND.Actor.Party.Card.NoMembers'}}</p>
      <p class="hint">{{localize 'VAGABOND.Actor.Party.Card.NoMembersHint'}}</p>
    </div>
  {{/if}}

</section>
