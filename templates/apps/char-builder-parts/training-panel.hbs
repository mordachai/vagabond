{{!-- Training owed, per source (Stats step). Checked Skills are paid automatically. --}}
<div class="training-panel">
    <div class="training-panel-head">
        <strong>{{localize "VAGABOND.CharBuilder.Skills.PanelTitle"}}</strong>
        <i class="fa-solid fa-circle-question training-hint" data-tooltip="{{localize 'VAGABOND.CharBuilder.Skills.PanelHint'}}"></i>
        <span class="training-panel-note">{{localize "VAGABOND.CharBuilder.Skills.ValueNote"}}</span>
    </div>
    <div class="training-pools">
        {{#if skillTraining.lockedCard}}
        <div class="training-pool locked" data-tooltip="{{localize 'VAGABOND.CharBuilder.Skills.LockedTooltip'}}">
            <span class="pool-count"><i class="fas fa-lock"></i></span>
            <span class="pool-source">{{skillTraining.lockedCard.source}}</span>
            <span class="pool-detail">{{skillTraining.lockedCard.detail}}</span>
        </div>
        {{/if}}
        {{#each skillTraining.pools as |pool|}}
        <div class="training-pool {{#if pool.full}}full{{/if}}">
            <span class="pool-count">{{pool.used}}/{{pool.needed}}</span>
            <span class="pool-source">{{pool.source}}</span>
            <span class="pool-detail">{{pool.detail}}</span>
        </div>
        {{/each}}
    </div>
</div>
