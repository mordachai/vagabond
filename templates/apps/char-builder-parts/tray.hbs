{{!-- Tray Zone (visible on perks/spells/gear steps) --}}
<section class="tray-zone {{#unless showTray}}hidden{{/unless}}">
    <div class="tray-grid {{#if (and (eq step 'spells') noSpellChoices)}}no-sidebar{{/if}}">
        {{!-- Instruction column (left side); hidden when there are no spells to choose --}}
        {{#unless (and (eq step 'spells') noSpellChoices)}}
        <div class="tray-sidebar">
            {{!-- <h3>{{localize "VAGABOND.CharBuilder.TrayTitle"}}</h3> --}}
            <p><small>{{localize "VAGABOND.CharBuilder.TrayInstructions"}}</small></p>

            {{#if (eq step 'gear')}}
                {{#if inventorySlots}}
                    <div class="pack-summary">
                        <p><strong>{{localize "VAGABOND.CharBuilder.InventorySlotsColon"}}</strong> {{inventorySlots.occupied}}/{{inventorySlots.max}} ({{localize "VAGABOND.CharBuilder.FreeColon"}} {{inventorySlots.free}})</p>
                    </div>
                {{/if}}
            {{/if}}

            {{#if (eq step 'perks')}}
                {{#if perkLimit}}
                    <div class="tray-counter {{#if (gte currentPerkCount perkLimit)}}done{{/if}}">
                        <span class="tray-counter-label">{{localize "VAGABOND.CharBuilder.CounterPerks"}}</span>
                        <span class="tray-counter-value">{{currentPerkCount}}<span class="tray-counter-max">/{{perkLimit}}</span></span>
                        <span class="tray-counter-note">
                            {{#if (gte currentPerkCount perkLimit)}}<i class="fas fa-check"></i> {{localize "VAGABOND.CharBuilder.CounterAllChosen"}}{{else}}{{localize "VAGABOND.CharBuilder.CounterChooseMore"}}{{/if}}
                        </span>
                    </div>
                {{/if}}
            {{/if}}

            {{#if (eq step 'spells')}}
                {{#if spellLimit}}
                    <div class="tray-counter {{#if (gte currentSpellCount spellLimit)}}done{{/if}}">
                        <span class="tray-counter-label">{{localize "VAGABOND.CharBuilder.CounterSpells"}}</span>
                        <span class="tray-counter-value">{{currentSpellCount}}<span class="tray-counter-max">/{{spellLimit}}</span></span>
                        <span class="tray-counter-note">
                            {{#if (gte currentSpellCount spellLimit)}}<i class="fas fa-check"></i> {{localize "VAGABOND.CharBuilder.CounterAllChosen"}}{{else}}{{localize "VAGABOND.CharBuilder.CounterChooseMore"}}{{/if}}
                        </span>
                        {{#if requiredSpellCount}}
                            <span class="tray-counter-note">{{requiredSpellCount}} {{localize "VAGABOND.CharBuilder.SpellsRequiredSuffix"}}</span>
                        {{/if}}
                    </div>
                {{/if}}
            {{/if}}

            {{#if (eq step 'alchemy')}}
                <div class="tray-counter {{#if (gte currentFormulaCount formulaLimit)}}done{{/if}}">
                    <span class="tray-counter-label">{{localize "VAGABOND.CharBuilder.CounterFormulae"}}</span>
                    <span class="tray-counter-value">{{currentFormulaCount}}<span class="tray-counter-max">/{{formulaLimit}}</span></span>
                    <span class="tray-counter-note">
                        {{#if (gte currentFormulaCount formulaLimit)}}<i class="fas fa-check"></i> {{localize "VAGABOND.CharBuilder.CounterAllChosen"}}{{else}}{{localize "VAGABOND.CharBuilder.CounterChooseMore"}}{{/if}}
                    </span>
                    <span class="tray-counter-note">{{localize "VAGABOND.CharBuilder.FormulaCapNote" cap=formulaCapLabel}}</span>
                </div>
            {{/if}}

            <button type="button" class="btn-clear-tray" data-action="clearTray">
                <i class="fas fa-trash"></i> {{localize "VAGABOND.CharBuilder.Buttons.ClearTray"}}
            </button>
        </div>
        {{/unless}}

        {{!-- Items grid (4 columns) --}}
        <div class="tray-items-grid">
            {{#if (eq step 'perks')}}
                {{#if trayData.perks.length}}
                    {{#each trayData.perks as |item|}}
                        <div class="tray-item-compact {{#if item.isClassPerk}}from-class{{/if}}" data-uuid="{{item.uuid}}">
                            <img src="{{item.img}}" alt="{{item.name}}" class="tray-img">
                            <div class="tray-item-text">
                                <span class="tray-name">{{item.name}}{{#if item.isClassPerk}} <i class="fas fa-star" title="{{localize 'VAGABOND.CharBuilder.FromClass'}}"></i>{{/if}}</span>
                                {{#if item.grantLabel}}
                                    <span class="tray-grant-label">{{item.grantLabel}}</span>
                                {{/if}}
                            </div>
                            {{#if item.canDelete}}
                                <button type="button" class="btn-remove" data-action="removeFromTray" data-uuid="{{item.uuid}}" title="{{localize 'VAGABOND.CharBuilder.RemoveTooltip'}}">
                                    <i class="fas fa-times"></i>
                                </button>
                            {{else}}
                                <i class="fas fa-lock class-perk-lock" title="{{localize 'VAGABOND.CharBuilder.GrantedByClassTooltip'}}"></i>
                            {{/if}}
                        </div>
                    {{/each}}
                {{else}}
                    <div class="tray-empty-message">
                        <i class="fas fa-arrow-left"></i>
                        <p>{{localize "VAGABOND.CharBuilder.TrayEmpty"}}</p>
                    </div>
                {{/if}}
                {{#if (and perkLimit trayData.emptySlots.length)}}
                    {{#each trayData.emptySlots as |slot|}}
                        <div class="tray-item-compact perk-slot empty">
                            <div class="empty-slot-placeholder">
                                <i class="fas fa-plus-circle"></i>
                                <span class="empty-slot-text">{{localize "VAGABOND.CharBuilder.EmptySlot"}}</span>
                            </div>
                        </div>
                    {{/each}}
                {{/if}}
            {{else if (eq step 'spells')}}
                {{#if noSpellChoices}}
                    <div class="tray-no-spells-message">
                        <i class="fas fa-wand-sparkles"></i>
                        <div class="tray-no-spells-text">
                            <strong>{{localize "VAGABOND.CharBuilder.NoSpellChoicesTitle"}}</strong>
                            <p>{{localize "VAGABOND.CharBuilder.NoSpellChoicesHint"}}</p>
                        </div>
                    </div>
                {{/if}}
                {{#if requiredSpellCount}}
                    <div class="required-spells-notice">
                        <i class="fas fa-star"></i>
                        <strong>{{requiredSpellCount}}</strong> {{#if (eq requiredSpellCount 1)}}{{localize "VAGABOND.CharBuilder.GrantedSpellSingular"}}{{else}}{{localize "VAGABOND.CharBuilder.GrantedSpellPlural"}}{{/if}}
                    </div>
                {{/if}}

                {{!-- Always show selected spells, regardless of spell limit --}}
                {{#if trayData.spells.length}}
                    {{#each trayData.spells as |item|}}
                        <div class="tray-item-compact spell-slot filled {{#if item.isRequired}}required{{/if}}" data-uuid="{{item.uuid}}">
                            <img src="{{item.img}}" alt="{{item.name}}" class="tray-img">
                            <span class="tray-name">
                                {{item.name}}
                            </span>
                            {{#if item.isRequired}}
                                <i class="fas fa-lock required-lock" title="{{localize 'VAGABOND.CharBuilder.RequiredSpellTooltip'}}"></i>
                            {{else}}
                                <button type="button" class="btn-remove" data-action="removeFromTray" data-uuid="{{item.uuid}}" title="{{localize 'VAGABOND.CharBuilder.RemoveTooltip'}}">
                                    <i class="fas fa-times"></i>
                                </button>
                            {{/if}}
                        </div>
                    {{/each}}
                {{else if (not noSpellChoices)}}
                    {{!-- No spells selected yet --}}
                    <div class="tray-empty-message">
                        <i class="fas fa-arrow-left"></i>
                        <p>{{localize "VAGABOND.CharBuilder.TrayEmpty"}}</p>
                    </div>
                {{/if}}

                {{!-- Show empty slots only if spell limit exists (for spellcaster classes) --}}
                {{#if (and spellLimit trayData.emptySlots.length)}}
                    {{#each trayData.emptySlots as |slot|}}
                        <div class="tray-item-compact spell-slot empty">
                            <div class="empty-slot-placeholder">
                                <i class="fas fa-plus-circle"></i>
                                <span class="empty-slot-text">{{localize "VAGABOND.CharBuilder.EmptySlot"}}</span>
                            </div>
                        </div>
                    {{/each}}
                {{/if}}
            {{else if (eq step 'alchemy')}}
                {{#if trayData.formulas.length}}
                    {{#each trayData.formulas as |item|}}
                        <div class="tray-item-compact spell-slot filled" data-uuid="{{item.uuid}}">
                            <img src="{{item.img}}" alt="{{item.name}}" class="tray-img">
                            <div class="tray-info">
                                <span class="tray-name">{{item.name}}</span>
                                <span class="tray-meta">{{item.costLabel}}</span>
                            </div>
                            <button type="button" class="btn-remove" data-action="removeFromTray" data-uuid="{{item.uuid}}" title="{{localize 'VAGABOND.CharBuilder.RemoveTooltip'}}">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                    {{/each}}
                {{else}}
                    <div class="tray-empty-message">
                        <i class="fas fa-arrow-left"></i>
                        <p>{{localize "VAGABOND.CharBuilder.TrayEmpty"}}</p>
                    </div>
                {{/if}}
                {{#each trayData.emptySlots as |slot|}}
                    <div class="tray-item-compact spell-slot empty">
                        <div class="empty-slot-placeholder">
                            <i class="fas fa-plus-circle"></i>
                            <span class="empty-slot-text">{{localize "VAGABOND.CharBuilder.EmptySlot"}}</span>
                        </div>
                    </div>
                {{/each}}
            {{else if (eq step 'gear')}}
                {{#if trayData.isEmpty}}
                    <div class="tray-empty-message">
                        <i class="fas fa-arrow-left"></i>
                        <p>{{localize "VAGABOND.CharBuilder.TrayEmpty"}}</p>
                    </div>
                {{else}}
                    {{#each trayData.gear as |item|}}
                        <div class="tray-item-compact gear-item {{#if item.fromStartingPack}}from-pack{{/if}}" data-uuid="{{item.uuid}}">
                            <img src="{{item.img}}" alt="{{item.name}}" class="tray-img">
                            <div class="tray-info">
                                <span class="tray-name">{{item.name}}{{#if (gt item.qty 1)}} x{{item.qty}}{{/if}}</span>
                                <span class="tray-meta">{{item.slots}} {{localize "VAGABOND.CharBuilder.SlotsSuffix"}} • {{item.costDisplay}}</span>
                            </div>
                            {{#if item.canDelete}}
                                <button type="button" class="btn-remove" data-action="removeFromTray" data-uuid="{{item.uuid}}" title="{{localize 'VAGABOND.CharBuilder.RemoveTooltip'}}">
                                    <i class="fas fa-times"></i>
                                </button>
                            {{/if}}
                        </div>
                    {{/each}}
                {{/if}}
            {{/if}}
        </div>
    </div>
</section>
