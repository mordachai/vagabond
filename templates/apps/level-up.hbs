<div class="level-up-wrapper">
 <div class="lu-shell">
  <aside class="lu-side">
    <div class="char-image-container">
      <img class="profile-img" src="{{portrait}}" alt="" />
    </div>
    <div class="lu-xpbox">
      <span class="lu-xpbox-level">{{localize "VAGABOND.UI.Sections.Level"}} {{xpBox.from}} → {{xpBox.to}}</span>
      {{#if xpBox.text}}
        <span class="lu-xpbox-text {{#if xpBox.ready}}lu-ready{{/if}}">{{xpBox.text}}</span>
      {{else}}
        <span class="lu-xpbox-text lu-ready"><i class="fas fa-check"></i></span>
      {{/if}}
      <div class="lu-xp-bar"><div class="lu-xp-bar-fill {{#if xpBox.ready}}lu-ready{{/if}}" style="width: {{xpBox.percent}}%"></div></div>
      <span class="lu-xpbox-label {{#if xpBox.pending}}lu-pending{{/if}}">{{xpBox.label}}</span>
    </div>
    {{#if questionnaire.xpGained}}
      <button type="button" class="lu-btn lu-btn-primary lu-side-btn" data-action="awardXP">
        <i class="fas fa-star"></i> {{localize "VAGABOND.LevelUp.AwardXP" xp=questionnaire.xpGained}}
      </button>
    {{/if}}
    {{#if showLevelUpBtn}}
      <button type="button" class="lu-btn lu-btn-accent lu-side-btn" data-action="triggerLevelUp">
        <i class="fas fa-arrow-up"></i> {{localize "VAGABOND.LevelUp.Title"}}
      </button>
      <div class="lu-notice lu-side-notice"><i class="fas fa-circle-up"></i> {{levelUpNotice}}</div>
    {{/if}}
  </aside>

  <div class="lu-main">
  {{! Tab Bar }}
  <nav class="level-up-tabs">
    {{#each tabs}}
      <button class="level-up-tab {{#if active}}active{{/if}}" data-action="changeTab" data-tab="{{id}}">
        <i class="{{icon}}"></i> {{label}}
        {{#if (eq mark 'done')}}<i class="fas fa-check lu-tab-ok"></i>{{else if (eq mark 'pending')}}<span class="lu-tab-dot"></span>{{/if}}
      </button>
    {{/each}}

    {{! GM Override Toggle }}
    {{#if isGM}}
      <label class="gm-override-toggle" data-tooltip="{{localize 'VAGABOND.LevelUp.GmOverrideTooltip'}}">
        <input type="checkbox" {{#if gmOverride}}checked{{/if}} data-action="toggleGmOverride" />
        <i class="fas fa-user-shield"></i> {{localize "VAGABOND.LevelUp.GM"}}
      </label>
    {{/if}}
  </nav>

  {{! Tab Content }}
  <div class="level-up-tab-content">

    {{! ─── Class pick (Level 0 → 1) ─── }}
    {{#if (eq activeTab 'class')}}
      <section class="lu-tab lu-class">
        <h3><i class="fas fa-shield-halved"></i> {{localize "VAGABOND.LevelUp.ChooseClass"}}</h3>
        <p class="lu-instruction">{{localize "VAGABOND.LevelUp.ChooseClassInstruction"}}</p>

        <div class="lu-two-col">
          <div class="lu-list">
            {{#each classPick.classes}}
              <div class="lu-list-item {{#if isSelected}}chosen{{/if}}" data-action="selectClass" data-uuid="{{uuid}}">
                <img src="{{img}}" alt="" class="lu-list-img" />
                <span class="lu-list-name">{{name}}</span>
                {{#if isSelected}}<span class="lu-badge owned"><i class="fas fa-check"></i></span>{{/if}}
              </div>
            {{/each}}
          </div>

          <div class="lu-preview">
            {{#if classPick.preview}}
              <div class="lu-preview-header">
                <img src="{{classPick.preview.img}}" alt="" class="lu-preview-img" />
                <h4>{{classPick.preview.name}}</h4>
              </div>
              <div class="lu-preview-body">{{{classPick.preview.description}}}</div>
            {{else}}
              <p class="lu-placeholder">{{localize "VAGABOND.LevelUp.ChooseClass"}}</p>
            {{/if}}
          </div>
        </div>
      </section>
    {{/if}}

    {{! ─── XP Questionnaire ─── }}
    {{#if (eq activeTab 'questionnaire')}}
      <section class="lu-tab lu-questionnaire">
        <h3><i class="fas fa-star"></i> {{localize "VAGABOND.LevelUp.SessionXPQuestionnaire"}}</h3>
        <p class="lu-instruction">{{localize "VAGABOND.LevelUp.Instruction"}}</p>

        <div class="lu-questions">
          {{#each questionnaire.questions}}
            <label class="lu-question {{#if checked}}checked{{/if}}" data-action="toggleQuestion" data-index="{{index}}">
              <span class="lu-checkbox">
                {{#if checked}}<i class="fas fa-check-square"></i>{{else}}<i class="far fa-square"></i>{{/if}}
              </span>
              <span class="lu-question-text">{{label}}</span>
            </label>
          {{/each}}
        </div>
      </section>
    {{/if}}

    {{! ─── Summary ─── }}
    {{#if (eq activeTab 'summary')}}
      <section class="lu-tab lu-summary">
        <h3><i class="fas fa-scroll"></i> {{localize "VAGABOND.LevelUp.LevelSummary" level=newLevel}}</h3>

        {{#if summary.status}}<p class="lu-instruction">{{summary.status}}</p>{{/if}}

        <h4 class="lu-subhead">{{summary.gainTitle}}</h4>
        <div class="lu-gains">
          {{#each summary.rows}}
            {{#if desc}}
              <details class="lu-gain {{state}}">
                <summary><span class="lu-mark"><i class="{{markIcon}}"></i></span><span class="lu-gain-label">{{label}}</span></summary>
                <div class="lu-gain-desc">{{{desc}}}</div>
              </details>
            {{else if tab}}
              <button type="button" class="lu-gain lu-gain-link {{state}}" data-action="changeTab" data-tab="{{tab}}" {{#if tip}}data-tooltip="{{tip}}"{{/if}}>
                <span class="lu-mark"><i class="{{markIcon}}"></i></span><span class="lu-gain-label">{{label}}</span>
                {{#if must}}<span class="lu-gain-must">{{must}}</span>{{/if}}
              </button>
            {{else}}
              <div class="lu-gain {{state}}" {{#if tip}}data-tooltip="{{tip}}"{{/if}}>
                <span class="lu-mark"><i class="{{markIcon}}"></i></span><span class="lu-gain-label">{{label}}</span>
              </div>
            {{/if}}
          {{/each}}
        </div>
      </section>
    {{/if}}

    {{! ─── Build Guide ─── }}
    {{#if (eq activeTab 'guide')}}
      <section class="lu-tab lu-guide">
        <h3><i class="fas fa-route"></i> {{guide.title}}</h3>

        {{#if guide.hasGoals}}
          <h4 class="lu-subhead">{{localize "VAGABOND.LevelUp.GuideStatGoals"}}</h4>
          <div class="lu-goals">
            {{#each guide.goals}}
              <div class="lu-goal"><span>{{abbr}}</span><b>{{current}} → {{target}}</b></div>
            {{/each}}
          </div>
        {{/if}}

        <div class="lu-guide-cols {{#unless guide.hasSpells}}single{{/unless}}">
          <div>
            <h4 class="lu-subhead">{{localize "VAGABOND.LevelUp.GuidePerks"}}</h4>
            <div class="lu-road">
              {{#each guide.levels}}
                <span class="lu-road-lv {{#if now}}now{{/if}}">L{{level}}</span>
                {{#if jump}}
                  <button type="button" class="lu-road-pk lu-road-link now {{#if taken}}taken{{/if}}" data-action="changeTab" data-tab="perks" data-perk-name="{{jumpName}}" data-perk-id="{{jumpId}}">
                    {{#if taken}}<i class="fas fa-check"></i> {{/if}}{{text}} <span class="lu-dim">→ {{localize "VAGABOND.LevelUp.TabPerks"}}</span>
                  </button>
                {{else}}
                  <span class="lu-road-pk {{#if taken}}taken{{/if}} {{#if now}}now{{/if}}">{{#if taken}}<i class="fas fa-check"></i> {{/if}}{{#if text}}{{text}}{{else}}—{{/if}}</span>
                {{/if}}
              {{/each}}
            </div>
          </div>

          {{#if guide.hasSpells}}
            <div>
              <h4 class="lu-subhead">{{localize "VAGABOND.UI.Sections.Spells"}}</h4>
              <div class="lu-guide-spells">
                {{#if guide.start.length}}
                  <span class="lu-guide-k">{{localize "VAGABOND.LevelUp.GuideStart"}}</span>
                  {{#each guide.start}}<span>{{#if owned}}<i class="fas fa-check"></i> {{/if}}{{name}}</span>{{/each}}
                {{/if}}
                {{#if guide.later.length}}
                  <span class="lu-guide-k">{{localize "VAGABOND.LevelUp.GuideLater"}}</span>
                  {{#each guide.later}}<span>{{#if owned}}<i class="fas fa-check"></i> {{/if}}{{name}}</span>{{/each}}
                {{/if}}
              </div>
            </div>
          {{/if}}
        </div>
      </section>
    {{/if}}

    {{! ─── Stat Increase ─── }}
    {{#if (eq activeTab 'stats')}}
      <section class="lu-tab lu-stats">
        <h3><i class="fas fa-chart-bar"></i> {{localize "VAGABOND.LevelUp.StatIncrease"}}</h3>
        <p class="lu-instruction">{{localize "VAGABOND.LevelUp.ChooseStatInstruction" cap=statIncrease.statCap}}</p>

        <div class="lu-stat-grid lu-one-row">
          {{#each statIncrease.stats}}
            <button type="button"
                    class="lu-stat-card {{#if isSelected}}selected{{/if}} {{#if isMaxed}}maxed{{/if}}"
                    data-action="selectStat"
                    data-stat="{{key}}"
                    {{#if isMaxed}}disabled{{/if}}>
              <span class="lu-stat-name">{{label}}</span>
              {{#if isGuidePick}}<span class="lu-badge guide">{{localize "VAGABOND.LevelUp.GuidePick"}}</span>{{/if}}
              <span class="lu-stat-value">{{current}}</span>
              {{#if isSelected}}<span class="lu-stat-delta">+1</span>{{/if}}
              {{#if isMaxed}}<span class="lu-stat-max">{{localize "VAGABOND.LevelUp.Max"}}</span>{{/if}}
            </button>
          {{/each}}
        </div>

        {{! Training from Reason (raising Reason past a half-RSN threshold) }}
        {{#if statIncrease.reasonTraining}}
          <p class="lu-instruction">{{localize "VAGABOND.LevelUp.ReasonTrainingInstruction"}}</p>
          <div class="lu-stat-grid">
            {{#each statIncrease.reasonTraining}}
              <button type="button"
                      class="lu-stat-card {{#if isSelected}}selected{{/if}}"
                      data-action="selectReasonTraining"
                      data-skill="{{key}}">
                <span class="lu-stat-name">{{label}}</span>
                {{#if isSelected}}<span class="lu-stat-delta"><i class="fas fa-check"></i></span>{{/if}}
              </button>
            {{/each}}
          </div>
        {{/if}}

        {{! Derived Stats Preview }}
        <div class="lu-derived-stats">
          <h4>{{localize "VAGABOND.LevelUp.CharacterStats"}}</h4>
          <div class="lu-derived-grid lu-grid-3col">
            <div class="lu-derived-item {{#if statIncrease.derived.hpChanged}}lu-changed{{/if}}">
              <span class="lu-derived-label">HP</span>
              <span class="lu-derived-dots"></span>
              <span class="lu-derived-value">{{#if statIncrease.derived.hpChanged}}<span class="lu-old-val">{{statIncrease.derived.hp}}</span> {{statIncrease.derived.hpPreview}}{{else}}{{statIncrease.derived.hp}}{{/if}}</span>
            </div>
            {{#if statIncrease.derived.isSpellcaster}}
              <div class="lu-derived-item {{#if statIncrease.derived.manaChanged}}lu-changed{{/if}}">
                <span class="lu-derived-label">{{localize "VAGABOND.ResourceTypes.MaxMana"}}</span>
                <span class="lu-derived-dots"></span>
                <span class="lu-derived-value">{{#if statIncrease.derived.manaChanged}}<span class="lu-old-val">{{statIncrease.derived.manaMax}}</span> {{statIncrease.derived.manaMaxPreview}}{{else}}{{statIncrease.derived.manaMax}}{{/if}}</span>
              </div>
              <div class="lu-derived-item {{#if statIncrease.derived.manaCastChanged}}lu-changed{{/if}}">
                <span class="lu-derived-label">{{localize "VAGABOND.ResourceTypes.ManaPerCast"}}</span>
                <span class="lu-derived-dots"></span>
                <span class="lu-derived-value">{{#if statIncrease.derived.manaCastChanged}}<span class="lu-old-val">{{statIncrease.derived.manaCast}}</span> {{statIncrease.derived.manaCastPreview}}{{else}}{{statIncrease.derived.manaCast}}{{/if}}</span>
              </div>
            {{/if}}
            <div class="lu-derived-item {{#if statIncrease.derived.luckChanged}}lu-changed{{/if}}">
              <span class="lu-derived-label">{{localize "VAGABOND.UI.Sections.LuckPool"}}</span>
              <span class="lu-derived-dots"></span>
              <span class="lu-derived-value">{{#if statIncrease.derived.luckChanged}}<span class="lu-old-val">{{statIncrease.derived.luckPool}}</span> {{statIncrease.derived.luckPreview}}{{else}}{{statIncrease.derived.luckPool}}{{/if}}</span>
            </div>
            <div class="lu-derived-item {{#if statIncrease.derived.inventoryChanged}}lu-changed{{/if}}">
              <span class="lu-derived-label">{{localize "VAGABOND.UI.Sections.Inventory"}}</span>
              <span class="lu-derived-dots"></span>
              <span class="lu-derived-value">{{#if statIncrease.derived.inventoryChanged}}<span class="lu-old-val">{{statIncrease.derived.inventory}}</span> {{statIncrease.derived.inventoryPreview}}{{else}}{{statIncrease.derived.inventory}}{{/if}}</span>
            </div>
            <div class="lu-derived-item {{#if statIncrease.derived.speedChanged}}lu-changed{{/if}}">
              <span class="lu-derived-label">{{localize "VAGABOND.UI.Sections.Speed"}}</span>
              <span class="lu-derived-dots"></span>
              <span class="lu-derived-value">{{#if statIncrease.derived.speedChanged}}<span class="lu-old-val">{{statIncrease.derived.speed}}</span> {{statIncrease.derived.speedPreview}}{{else}}{{statIncrease.derived.speed}}{{/if}}</span>
            </div>
          </div>

          {{! Saves }}
          <h4>{{localize "VAGABOND.Saves.savesTitle"}}</h4>
          <div class="lu-derived-grid lu-grid-3col">
            {{#each statIncrease.derived.saves}}
              <div class="lu-derived-item {{#if changed}}lu-changed{{/if}}">
                <span class="lu-derived-label">{{label}}{{#if statAbbr}} <span class="lu-stat-abbr">[{{statAbbr}}]</span>{{/if}}</span>
                <span class="lu-derived-dots"></span>
                <span class="lu-derived-value">{{#if changed}}<span class="lu-old-val">{{value}}</span> {{previewValue}}{{else}}{{value}}{{/if}}</span>
              </div>
            {{/each}}
          </div>

          {{! Skills }}
          <h4>{{localize "VAGABOND.UI.Sections.Skills"}}</h4>
          <div class="lu-derived-grid lu-grid-4col">
            {{#each statIncrease.derived.skills}}
              <div class="lu-derived-item {{#if trained}}lu-trained{{/if}} {{#if changed}}lu-changed{{/if}}">
                <span class="lu-derived-label">
                  {{#if trained}}<strong>{{/if}}
                  {{label}}{{#if statAbbr}} <span class="lu-stat-abbr">[{{statAbbr}}]</span>{{/if}}
                  {{#if trained}}</strong>{{/if}}
                </span>
                <span class="lu-derived-dots"></span>
                <span class="lu-derived-value">{{#if changed}}<span class="lu-old-val">{{value}}</span> {{previewValue}}{{else}}{{value}}{{/if}}</span>
              </div>
            {{/each}}
          </div>

          {{! Weapon Skills }}
          <h4>{{localize "VAGABOND.UI.Labels.WeaponSkills"}}</h4>
          <div class="lu-derived-grid lu-grid-4col">
            {{#each statIncrease.derived.weaponSkills}}
              <div class="lu-derived-item {{#if trained}}lu-trained{{/if}} {{#if changed}}lu-changed{{/if}}">
                <span class="lu-derived-label">
                  {{#if trained}}<strong>{{/if}}
                  {{label}}{{#if statAbbr}} <span class="lu-stat-abbr">[{{statAbbr}}]</span>{{/if}}
                  {{#if trained}}</strong>{{/if}}
                </span>
                <span class="lu-derived-dots"></span>
                <span class="lu-derived-value">{{#if changed}}<span class="lu-old-val">{{value}}</span> {{previewValue}}{{else}}{{value}}{{/if}}</span>
              </div>
            {{/each}}
          </div>
        </div>
      </section>
    {{/if}}

    {{! ─── Perks ─── }}
    {{#if (eq activeTab 'perks')}}
      <section class="lu-tab lu-perks">
        <div class="lu-perks-header">
          <h3><i class="fas fa-gem"></i> {{localize "VAGABOND.LevelUp.ChooseAPerk"}}</h3>
          {{#if perks.hiddenCount}}
            <button type="button" class="lu-btn lu-btn-small" data-action="toggleShowAllPerks">
              {{#if perks.showAllPerks}}
                <i class="fas fa-eye-slash"></i> {{localize "VAGABOND.LevelUp.HideUnqualified" count=perks.hiddenCount}}
              {{else}}
                <i class="fas fa-eye"></i> {{localize "VAGABOND.LevelUp.ShowAll" count=perks.hiddenCount}}
              {{/if}}
            </button>
          {{/if}}
        </div>

        {{! Tray (chosen perk) }}
        {{#if perks.hasChosen}}
          <div class="lu-tray">
            <div class="lu-tray-item">
              <img src="{{perks.chosenPerk.img}}" alt="" class="lu-tray-img" />
              <span class="lu-tray-name">{{perks.chosenPerk.name}}</span>
              {{#if perks.chosenPerk.choiceLabel}}
                <span class="lu-tray-choice">({{perks.chosenPerk.choiceLabel}})</span>
              {{/if}}
              <button type="button" class="lu-tray-remove" data-action="removePerk">
                <i class="fas fa-times"></i>
              </button>
            </div>
          </div>
        {{/if}}

        <div class="lu-two-col">
          {{! Perk List }}
          <div class="lu-list">
            {{#each perks.availablePerks}}
              <div class="lu-list-item {{#if isPreviewing}}previewing{{/if}} {{#if isChosen}}chosen{{/if}} {{#unless prerequisitesMet}}prereq-fail{{/unless}}"
                   data-action="selectPerk" data-uuid="{{uuid}}">
                <img src="{{img}}" alt="" class="lu-list-img" />
                <span class="lu-list-name">{{name}}</span>
                {{#if isGuide}}<span class="lu-badge guide">{{localize "VAGABOND.LevelUp.GuidePick"}}</span>{{/if}}
                {{#if isOwned}}<span class="lu-badge taken">{{localize "VAGABOND.LevelUp.Taken"}}{{#if ownedCount}} x{{ownedCount}}{{/if}}</span>{{/if}}
                {{#unless prerequisitesMet}}<span class="lu-badge prereq"><i class="fas fa-lock"></i></span>{{/unless}}
              </div>
            {{/each}}
          </div>

          {{! Preview Panel }}
          <div class="lu-preview">
            {{#if perks.previewItem}}
              <div class="lu-preview-header">
                <img src="{{perks.previewItem.img}}" alt="" class="lu-preview-img" />
                <h4>{{perks.previewItem.name}}</h4>
              </div>
              {{#if perks.previewItem.hasPrereqs}}
                <div class="lu-prereq-list">
                  <strong>{{localize "VAGABOND.Item.Perk.FIELDS.prerequisites.label"}}:</strong>
                  <ul>
                    {{#each perks.previewItem.allPrereqs}}
                      <li class="{{#if met}}prereq-met{{else}}prereq-unmet{{/if}}">
                        <i class="fas {{#if met}}fa-check-circle{{else}}fa-times-circle{{/if}}"></i>
                        {{text}}
                      </li>
                    {{/each}}
                  </ul>
                </div>
              {{/if}}
              <div class="lu-preview-body">{{{perks.previewItem.enrichedDescription}}}</div>
              {{#unless perks.hasChosen}}
                <button type="button" class="lu-btn lu-btn-primary" data-action="addPerk" data-uuid="{{perks.previewItem.uuid}}">
                  <i class="fas fa-plus"></i> {{localize "VAGABOND.LevelUp.SelectPerk"}}
                  {{#unless perks.previewItem.prerequisitesMet}}
                    <span class="lu-btn-note">{{localize "VAGABOND.LevelUp.PrereqsNotMet"}}</span>
                  {{/unless}}
                </button>
              {{/unless}}
            {{else}}
              <p class="lu-placeholder">{{localize "VAGABOND.LevelUp.SelectPerkPreview"}}</p>
            {{/if}}
          </div>
        </div>
      </section>
    {{/if}}

    {{! ─── Spells ─── }}
    {{#if (eq activeTab 'spells')}}
      <section class="lu-tab lu-spells">
        <h3><i class="fas fa-hat-wizard"></i> {{localize "VAGABOND.LevelUp.LearnNewSpells"}}</h3>
        <p class="lu-instruction">{{localize "VAGABOND.LevelUp.ChooseSpellsInstruction" max=spells.maxNewSpells current=spells.currentCount}}</p>

        {{! Tray (chosen spells) }}
        {{#if spells.chosenSpells}}
          <div class="lu-tray">
            {{#each spells.chosenSpells}}
              <div class="lu-tray-item">
                <img src="{{img}}" alt="" class="lu-tray-img" />
                <span class="lu-tray-name">{{name}}</span>
                <button type="button" class="lu-tray-remove" data-action="removeSpell" data-uuid="{{uuid}}">
                  <i class="fas fa-times"></i>
                </button>
              </div>
            {{/each}}
          </div>
        {{/if}}

        <div class="lu-two-col">
          {{! Spell List }}
          <div class="lu-list">
            {{#each spells.availableSpells}}
              <div class="lu-list-item {{#if isPreviewing}}previewing{{/if}} {{#if isChosen}}chosen{{/if}} {{#if isOwned}}owned{{/if}} {{#if isRequired}}required{{/if}}"
                   data-action="selectSpell" data-uuid="{{uuid}}">
                <img src="{{img}}" alt="" class="lu-list-img" />
                <span class="lu-list-name">{{name}}</span>
                {{#if baseDamage}}<span class="lu-spell-info">{{baseDamage}}</span>{{/if}}
                {{#if damageType}}<span class="lu-spell-dmg"><i class="{{damageTypeIcon}}"></i></span>{{/if}}
                {{#if isGuide}}{{#unless isOwned}}<span class="lu-badge guide">{{localize "VAGABOND.LevelUp.GuidePick"}}</span>{{/unless}}{{/if}}
                {{#if isOwned}}<span class="lu-badge owned">{{localize "VAGABOND.LevelUp.Known"}}</span>{{/if}}
                {{#if isRequired}}<span class="lu-badge required">{{localize "VAGABOND.LevelUp.Required"}}</span>{{/if}}
              </div>
            {{/each}}
          </div>

          {{! Preview Panel }}
          <div class="lu-preview">
            {{#if spells.previewItem}}
              <div class="lu-preview-header">
                <img src="{{spells.previewItem.img}}" alt="" class="lu-preview-img" />
                <div class="lu-preview-title">
                  <h4>{{spells.previewItem.name}}</h4>
                  {{#if spells.previewItem.damageType}}
                    <span class="lu-preview-type">
                      <strong>{{localize "VAGABOND.UI.Labels.TypeLabel"}}:</strong>
                      {{#if spells.previewItem.damageTypeIcon}}<i class="{{spells.previewItem.damageTypeIcon}}"></i>{{/if}}
                      {{spells.previewItem.damageType}}
                    </span>
                  {{/if}}
                </div>
              </div>
              <div class="lu-spell-details">
                {{#if spells.previewItem.baseDamage}}<div class="lu-spell-detail"><strong>{{localize "VAGABOND.UI.Labels.DamageBase"}}:</strong> {{spells.previewItem.baseDamage}}</div>{{/if}}
                {{#if spells.previewItem.manaCost}}<div class="lu-spell-detail"><strong>{{localize "VAGABOND.Item.Spell.FIELDS.delivery.cost.label"}}:</strong> {{spells.previewItem.manaCost}}</div>{{/if}}
                {{#if spells.previewItem.deliveryLabel}}<div class="lu-spell-detail"><strong>{{localize "VAGABOND.UI.Labels.Delivery"}}:</strong> {{spells.previewItem.deliveryLabel}}</div>{{/if}}
                {{#if spells.previewItem.range}}<div class="lu-spell-detail"><strong>{{localize "VAGABOND.UI.Labels.Range"}}:</strong> {{spells.previewItem.range}}</div>{{/if}}
              </div>
              <div class="lu-preview-body">{{{spells.previewItem.enrichedDescription}}}</div>
              {{#if (or spells.previewItem.crit spells.previewItem.duration)}}
                <div class="lu-spell-details lu-spell-details-bottom">
                  {{#if spells.previewItem.crit}}<div class="lu-spell-detail"><strong>{{localize "VAGABOND.UI.Labels.Critical"}}:</strong> {{spells.previewItem.crit}}</div>{{/if}}
                  {{#if spells.previewItem.duration}}<div class="lu-spell-detail"><strong>{{localize "VAGABOND.Item.Spell.FIELDS.duration.label"}}:</strong> {{spells.previewItem.duration}}</div>{{/if}}
                </div>
              {{/if}}
              {{#if spells.previewItem.isOwned}}
                <span class="lu-owned-notice"><i class="fas fa-check"></i> {{localize "VAGABOND.LevelUp.AlreadyKnown"}}</span>
              {{else if spells.previewItem.isChosen}}
                <span class="lu-owned-notice"><i class="fas fa-check"></i> {{localize "VAGABOND.LevelUp.Selected"}}</span>
              {{else if spells.canAddMore}}
                <button type="button" class="lu-btn lu-btn-primary" data-action="addSpell" data-uuid="{{spells.previewItem.uuid}}">
                  <i class="fas fa-plus"></i> {{localize "VAGABOND.LevelUp.LearnSpell"}}
                </button>
              {{/if}}
            {{else}}
              <p class="lu-placeholder">{{localize "VAGABOND.LevelUp.SelectSpellPreview"}}</p>
            {{/if}}
          </div>
        </div>
      </section>
    {{/if}}

  </div>

  </div>{{! lu-main }}
 </div>{{! lu-shell }}

  {{! ─── Persistent Footer ─── }}
  <footer class="lu-footer">
    <div class="lu-footer-row">
      {{#if showGrantLevelBtn}}
        <button type="button" class="lu-btn lu-btn-large" data-action="grantLevel" data-tooltip="{{localize 'VAGABOND.LevelUp.GrantLevelTooltip'}}">
          <i class="fas fa-flag-checkered"></i> {{localize "VAGABOND.LevelUp.GrantLevel"}}
        </button>
      {{/if}}
      {{#if showApplyBtn}}
        <button type="button" class="lu-btn lu-btn-accent lu-btn-large" data-action="applyLevelUp" {{#unless allChecklistDone}}disabled{{/unless}}>
          <i class="fas fa-check-double"></i> {{localize "VAGABOND.LevelUp.ApplyAllChanges"}}
        </button>
      {{/if}}
      <button type="button" class="lu-btn lu-btn-large {{#if closePrimary}}lu-btn-accent{{/if}}" data-action="closeDialog">
        <i class="fas fa-xmark"></i> {{localize "VAGABOND.LevelUp.Close"}}
      </button>
    </div>
  </footer>
</div>
