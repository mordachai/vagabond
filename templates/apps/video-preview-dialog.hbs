<div class="vpd-wrapper">
  {{#if groups.length}}
    <nav class="vpd-groups" style="--vpd-cols: {{groupCols}}">
      {{#each groups}}
        <button type="button" class="vpd-group-btn {{#if active}}active{{/if}}" data-action="selectGroup" data-index="{{index}}">{{label}}</button>
      {{/each}}
    </nav>
  {{/if}}
  <div class="vpd-video-container">
    <video class="vpd-video" src="{{file}}" playsinline muted></video>
    {{#if sound}}<audio class="vpd-audio" src="{{sound}}" preload="auto"></audio>{{/if}}
  </div>
  {{#if frame}}
    <div class="vpd-frame" data-tooltip="{{localize 'VAGABOND.VideoPreview.FrameTooltip'}}">
      <span class="vpd-frame-label">{{localize "VAGABOND.VideoPreview.Frame"}}</span>
      <input type="range" class="vpd-frame-range" min="0" max="100" step="1" value="{{frame.range}}">
      <input type="number" class="vpd-frame-num" min="0" max="100" step="1" value="{{frame.value}}" placeholder="{{localize 'VAGABOND.VideoPreview.Loop'}}">
      <span class="vpd-frame-pct">%</span>
      <button type="button" class="vpd-use-frame" data-action="useFrame" data-tooltip="{{localize 'VAGABOND.VideoPreview.UseFrameTooltip'}}">
        <i class="fas fa-thumbtack"></i> {{localize "VAGABOND.VideoPreview.UseFrame"}}
      </button>
    </div>
  {{/if}}
  <footer class="vpd-footer">
    {{#if hasVariants}}
      <button type="button" class="vpd-step-btn" data-action="stepVariant" data-dir="-1" data-tooltip="{{localize 'VAGABOND.VideoPreview.PrevVariant'}}">
        <i class="fas fa-chevron-left"></i>
      </button>
      <span class="vpd-counter">{{variantIndex}} / {{variantCount}}{{#if variantFt}} · {{variantFt}} ft{{/if}}</span>
      <button type="button" class="vpd-step-btn" data-action="stepVariant" data-dir="1" data-tooltip="{{localize 'VAGABOND.VideoPreview.NextVariant'}}">
        <i class="fas fa-chevron-right"></i>
      </button>
    {{/if}}
    <button type="button" class="vpd-play-btn" data-action="replay" title="{{localize 'VAGABOND.VideoPreview.ReplayTooltip'}}">
      <i class="fas fa-play"></i> {{localize "VAGABOND.VideoPreview.Play"}}
    </button>
    <button type="button" class="vpd-loop-btn {{#if loop}}active{{/if}}" data-action="toggleLoop" title="{{localize 'VAGABOND.VideoPreview.ToggleLoopTooltip'}}">
      <i class="fas fa-repeat"></i> {{localize "VAGABOND.VideoPreview.Loop"}}
    </button>
    {{#if sound}}
      <label class="vpd-mute">
        <input type="checkbox" {{#if muted}}checked{{/if}}> {{localize "VAGABOND.VideoPreview.Mute"}}
      </label>
    {{/if}}
  </footer>
  <div class="vpd-filename" title="{{file}}">{{fileName}}</div>
</div>
