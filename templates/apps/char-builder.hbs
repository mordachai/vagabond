<form class="vagabond-builder flexcol" autocomplete="off">
    {{> navigation}}

    <main class="builder-body {{#if guideStage}}is-guide-stage{{/if}}">
        {{#if guideStage}}
            {{> guide-stage}}
        {{else}}
        {{> sidebar}}

        <div class="right-column">
            {{> tray}}
            <section class="content-zone {{#if useTripleColumn}}triple-column{{/if}}">
                {{> preview}}
                {{> reference}}
            </section>
        </div>
        {{/if}}
    </main>

    {{> footer}}
</form>
