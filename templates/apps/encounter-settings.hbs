<div class="flexcol standard-form">
  <section class="scrollable">
    <p class="notes">
      {{localize 'VAGABOND.EncounterSettings.Description'}}
    </p>

    <fieldset>
      <legend>{{localize 'VAGABOND.EncounterSettings.GeneralSettings'}}</legend>

      <div class="form-group">
        <label for="hideInitiativeRoll">
          <input type="checkbox" name="hideInitiativeRoll" id="hideInitiativeRoll" {{checked hideInitiativeRoll}}>
          {{localize 'VAGABOND.EncounterSettings.HideInitiativeRoll.Name'}}
        </label>
        <p class="hint">{{localize 'VAGABOND.EncounterSettings.HideInitiativeRoll.Hint'}}</p>
      </div>

      <div class="form-group">
        <label for="useActivationPoints">
          <input type="checkbox" name="useActivationPoints" id="useActivationPoints" {{checked useActivationPoints}}>
          {{localize 'VAGABOND.EncounterSettings.UseActivationPoints.Name'}}
        </label>
        <p class="hint">{{localize 'VAGABOND.EncounterSettings.UseActivationPoints.Hint'}}</p>
      </div>

      <div class="form-group">
        <label for="defaultActivationPoints">{{localize 'VAGABOND.EncounterSettings.DefaultActivationPoints.Name'}}</label>
        <input type="number" name="defaultActivationPoints" id="defaultActivationPoints" value="{{defaultActivationPoints}}" min="1" max="10" step="1">
        <p class="hint">{{localize 'VAGABOND.EncounterSettings.DefaultActivationPoints.Hint'}}</p>
      </div>

      <div class="form-group">
        <label for="initiativeFormula">{{localize 'VAGABOND.EncounterSettings.InitiativeFormula.Name'}}</label>
        <input type="text" name="initiativeFormula" id="initiativeFormula" value="{{initiativeFormula}}" placeholder="3d6 + @dexterity.value + @awareness.value">
        <p class="hint">{{localize 'VAGABOND.EncounterSettings.InitiativeFormula.Hint'}}</p>
      </div>

      <div class="form-group">
        <label for="npcInitiativeFormula">{{localize 'VAGABOND.EncounterSettings.NPCInitiativeFormula.Name'}}</label>
        <input type="text" name="npcInitiativeFormula" id="npcInitiativeFormula" value="{{npcInitiativeFormula}}" placeholder="3d6 + ceil(@speed / 10)">
        <p class="hint">{{localize 'VAGABOND.EncounterSettings.NPCInitiativeFormula.Hint'}}</p>
      </div>
    </fieldset>

    <fieldset>
      <legend>{{localize 'VAGABOND.EncounterSettings.Factions.Title'}}</legend>
      <div class="form-group faction-setting">
        <label for="factionFriendly">{{localize 'VAGABOND.EncounterSettings.Factions.Friendly'}}</label>
        <div class="input-row flexrow">
          <input type="text" name="factionFriendly" id="factionFriendly" value="{{factionFriendly}}">
          <input type="color" name="factionFriendlyColor" value="{{factionFriendlyColor}}" style="flex: 0 0 30px; padding: 0; border: none; height: 26px; cursor: pointer;">
        </div>
      </div>
      <div class="form-group faction-setting">
        <label for="factionNeutral">{{localize 'VAGABOND.EncounterSettings.Factions.Neutral'}}</label>
        <div class="input-row flexrow">
          <input type="text" name="factionNeutral" id="factionNeutral" value="{{factionNeutral}}">
          <input type="color" name="factionNeutralColor" value="{{factionNeutralColor}}" style="flex: 0 0 30px; padding: 0; border: none; height: 26px; cursor: pointer;">
        </div>
      </div>
      <div class="form-group faction-setting">
        <label for="factionHostile">{{localize 'VAGABOND.EncounterSettings.Factions.Hostile'}}</label>
        <div class="input-row flexrow">
          <input type="text" name="factionHostile" id="factionHostile" value="{{factionHostile}}">
          <input type="color" name="factionHostileColor" value="{{factionHostileColor}}" style="flex: 0 0 30px; padding: 0; border: none; height: 26px; cursor: pointer;">
        </div>
      </div>
      <div class="form-group faction-setting">
        <label for="factionSecret">{{localize 'VAGABOND.EncounterSettings.Factions.Secret'}}</label>
        <div class="input-row flexrow">
          <input type="text" name="factionSecret" id="factionSecret" value="{{factionSecret}}">
          <input type="color" name="factionSecretColor" value="{{factionSecretColor}}" style="flex: 0 0 30px; padding: 0; border: none; height: 26px; cursor: pointer;">
        </div>
      </div>
    </fieldset>

    <fieldset>
      <legend>{{localize 'VAGABOND.EncounterSettings.Carousel.Title'}}</legend>
      <div class="form-group">
        <label for="combatCarouselEnabled">
          <input type="checkbox" name="combatCarouselEnabled" id="combatCarouselEnabled" {{#if combatCarouselEnabled}}checked{{/if}}>
          {{localize 'VAGABOND.EncounterSettings.Carousel.Enabled.Name'}}
        </label>
        <p class="hint">{{localize 'VAGABOND.EncounterSettings.Carousel.Enabled.Hint'}}</p>
      </div>
      <div class="form-group">
        <label for="combatCarouselCardSelectBehavior">{{localize 'VAGABOND.EncounterSettings.Carousel.CardSelectBehavior.Name'}} (<i class='fas fa-computer-mouse'></i>L)</label>
        <select name="combatCarouselCardSelectBehavior" id="combatCarouselCardSelectBehavior">
          <option value="none" {{#if (eq combatCarouselCardSelectBehavior "none")}}selected{{/if}}>{{localize 'VAGABOND.EncounterSettings.Carousel.CardSelectBehavior.None'}}</option>
          <option value="pan" {{#if (eq combatCarouselCardSelectBehavior "pan")}}selected{{/if}}>{{localize 'VAGABOND.EncounterSettings.Carousel.CardSelectBehavior.Pan'}}</option>
          <option value="select" {{#if (eq combatCarouselCardSelectBehavior "select")}}selected{{/if}}>{{localize 'VAGABOND.EncounterSettings.Carousel.CardSelectBehavior.Select'}}</option>
          <option value="selectPan" {{#if (eq combatCarouselCardSelectBehavior "selectPan")}}selected{{/if}}>{{localize 'VAGABOND.EncounterSettings.Carousel.CardSelectBehavior.SelectPan'}}</option>
          <option value="ping" {{#if (eq combatCarouselCardSelectBehavior "ping")}}selected{{/if}}>{{localize 'VAGABOND.EncounterSettings.Carousel.CardSelectBehavior.Ping'}}</option>
          <option value="activate" {{#if (eq combatCarouselCardSelectBehavior "activate")}}selected{{/if}}>{{localize 'VAGABOND.EncounterSettings.Carousel.CardSelectBehavior.Activate'}}</option>
          <option value="activateSelect" {{#if (eq combatCarouselCardSelectBehavior "activateSelect")}}selected{{/if}}>{{localize 'VAGABOND.EncounterSettings.Carousel.CardSelectBehavior.ActivateSelect'}}</option>
          <option value="activatePan" {{#if (eq combatCarouselCardSelectBehavior "activatePan")}}selected{{/if}}>{{localize 'VAGABOND.EncounterSettings.Carousel.CardSelectBehavior.ActivatePan'}}</option>
        </select>
        <p class="hint">{{localize 'VAGABOND.EncounterSettings.Carousel.CardSelectBehavior.Hint'}}</p>
      </div>
      <div class="form-group">
        <label for="combatCarouselPortraitSize">{{localize 'VAGABOND.EncounterSettings.Carousel.PortraitSize.Name'}}</label>
        <select name="combatCarouselPortraitSize" id="combatCarouselPortraitSize">
          <option value="small" {{#if (eq combatCarouselPortraitSize "small")}}selected{{/if}}>{{localize 'VAGABOND.EncounterSettings.Carousel.PortraitSize.Small'}}</option>
          <option value="medium" {{#if (eq combatCarouselPortraitSize "medium")}}selected{{/if}}>{{localize 'VAGABOND.EncounterSettings.Carousel.PortraitSize.Medium'}}</option>
          <option value="large" {{#if (eq combatCarouselPortraitSize "large")}}selected{{/if}}>{{localize 'VAGABOND.EncounterSettings.Carousel.PortraitSize.Large'}}</option>
        </select>
        <p class="hint">{{localize 'VAGABOND.EncounterSettings.Carousel.PortraitSize.Hint'}}</p>
      </div>
      <div class="form-group">
        <label for="combatCarouselRevealOtherFactionStats">{{localize 'VAGABOND.EncounterSettings.Carousel.RevealOtherFactionStats.Name'}}</label>
        <input type="checkbox" name="combatCarouselRevealOtherFactionStats" id="combatCarouselRevealOtherFactionStats" {{#if combatCarouselRevealOtherFactionStats}}checked{{/if}}>
        <p class="hint">{{localize 'VAGABOND.EncounterSettings.Carousel.RevealOtherFactionStats.Hint'}}</p>
      </div>
      <div class="form-group">
        <label for="combatCarouselAutoHideDefault">{{localize 'VAGABOND.EncounterSettings.Carousel.AutoHideDefault.Name'}}</label>
        <input type="checkbox" name="combatCarouselAutoHideDefault" id="combatCarouselAutoHideDefault" {{#if combatCarouselAutoHideDefault}}checked{{/if}}>
        <p class="hint">{{localize 'VAGABOND.EncounterSettings.Carousel.AutoHideDefault.Hint'}}</p>
      </div>
      <div class="form-group">
        <label for="combatCarouselDimIdleDefault">{{localize 'VAGABOND.EncounterSettings.Carousel.DimIdleDefault.Name'}}</label>
        <input type="checkbox" name="combatCarouselDimIdleDefault" id="combatCarouselDimIdleDefault" {{#if combatCarouselDimIdleDefault}}checked{{/if}}>
        <p class="hint">{{localize 'VAGABOND.EncounterSettings.Carousel.DimIdleDefault.Hint'}}</p>
      </div>
    </fieldset>
  </section>

  <footer class="form-footer flexrow">
    <button type="submit" class="dialog-button default">
      <i class="fas fa-save"></i>
      {{localize 'VAGABOND.EncounterSettings.Save'}}
    </button>
    <button type="button" class="dialog-button" data-action="close">
      <i class="fas fa-times"></i>
      {{localize 'VAGABOND.EncounterSettings.Cancel'}}
    </button>
  </footer>
</div>
