{{! Unified grants configuration — shared by ancestry traits and class features.
    Named params: grant, arrayPath, itemIndex, enrichedGrant, config, editable }}
<div class='grants-accordions'>

  {{! ── STATS ─────────────────────────────────────────────────────────── }}
  <div class='accordion-item collapsed' data-accordion-id='grant-{{itemIndex}}-stats'>
    <div class='accordion-header' data-action='toggleAccordion'>
      <i class='accordion-icon fas fa-chevron-right'></i>
      <strong>{{localize "VAGABOND.UI.Sections.Stats"}}</strong>
    </div>
    <div class='accordion-content'>
      <div class='grants-accordion-body'>
        <div class='grants-row'>
          <label>{{localize "VAGABOND.UI.Labels.StatBonusPoints"}}</label>
          <input type='number'
            name='{{arrayPath}}.{{itemIndex}}.statBonusPoints'
            value='{{grant.statBonusPoints}}'
            min='0' max='10'
            class='grants-num-input' />
          <span class='grants-hint'>{{localize "VAGABOND.UI.Hints.StatBonusHint"}}</span>
        </div>
      </div>
    </div>
  </div>

  {{! ── SKILLS ─────────────────────────────────────────────────────────── }}
  <div class='accordion-item collapsed' data-accordion-id='grant-{{itemIndex}}-skills'>
    <div class='accordion-header' data-action='toggleAccordion'>
      <i class='accordion-icon fas fa-chevron-right'></i>
      <strong>{{localize "VAGABOND.UI.Sections.Skills"}}</strong>
    </div>
    <div class='accordion-content'>
      <div class='grants-accordion-body'>
        <div class='grants-row'>
          <label>{{localize "VAGABOND.UI.Labels.ExtraTraining"}}</label>
          <input type='number'
            name='{{arrayPath}}.{{itemIndex}}.extraTraining'
            value='{{grant.extraTraining}}'
            min='0' max='10'
            class='grants-num-input' />
          <span class='grants-hint'>{{localize "VAGABOND.UI.Hints.ExtraTrainingHint"}}</span>
        </div>

        <div class='grants-choice-groups'>
          <div class='grants-choice-header'>
            <label>{{localize "VAGABOND.UI.Labels.SkillChoices"}}</label>
            {{#if editable}}
              <button type='button' class='btn-sm'
                data-action='addGrantSkillChoiceGroup'
                data-array-path='{{arrayPath}}'
                data-item-index='{{itemIndex}}'>
                <i class='fas fa-plus'></i> {{localize "VAGABOND.UI.Buttons.AddChoiceGroup"}}
              </button>
            {{/if}}
          </div>

          {{#each grant.skillChoices as |choice choiceIndex|}}
            <div class='choice-group-card'>
              <div class='choice-group-header'>
                <strong>{{localize "VAGABOND.UI.Labels.Group"}} {{add choiceIndex 1}}</strong>
                {{#if ../editable}}
                  <a data-action='removeGrantSkillChoiceGroup'
                    data-array-path='{{../arrayPath}}'
                    data-item-index='{{../itemIndex}}'
                    data-choice-index='{{choiceIndex}}'
                    class='text-danger'>
                    <i class='fas fa-trash'></i>
                  </a>
                {{/if}}
              </div>
              <div class='grants-row'>
                <label>{{localize "VAGABOND.UI.Labels.Count"}}</label>
                <input type='number'
                  name='{{../arrayPath}}.{{../itemIndex}}.skillChoices.{{choiceIndex}}.count'
                  value='{{choice.count}}'
                  min='1' max='10'
                  class='grants-num-input' />
                <input type='text'
                  name='{{../arrayPath}}.{{../itemIndex}}.skillChoices.{{choiceIndex}}.label'
                  value='{{choice.label}}'
                  placeholder='{{localize "VAGABOND.UI.Hints.LabelPlaceholder"}}'
                  class='grants-label-input' />
              </div>
              <div class='skill-pool-checkboxes'>
                {{#each ../config.skills as |skillLabel skillKey|}}
                  <label class='skill-checkbox-label'>
                    <input type='checkbox'
                      name='{{../../arrayPath}}.{{../../itemIndex}}.skillChoices.{{choiceIndex}}.pool'
                      value='{{skillKey}}'
                      {{#if (contains choice.pool skillKey)}}checked{{/if}}
                      {{#unless ../../editable}}disabled{{/unless}} />
                    <span>{{skillLabel}}</span>
                  </label>
                {{/each}}
              </div>
              {{#unless choice.pool.length}}
                <small class='text-muted'>{{localize "VAGABOND.UI.Hints.EmptyForAny"}}</small>
              {{/unless}}
            </div>
          {{/each}}
        </div>
      </div>
    </div>
  </div>

  {{! ── SPELLS ──────────────────────────────────────────────────────────── }}
  <div class='accordion-item collapsed' data-accordion-id='grant-{{itemIndex}}-spells'>
    <div class='accordion-header' data-action='toggleAccordion'>
      <i class='accordion-icon fas fa-chevron-right'></i>
      <strong>{{localize "VAGABOND.UI.Sections.Spells"}}</strong>
    </div>
    <div class='accordion-content'>
      <div class='grants-accordion-body'>
        <div class='grants-row'>
          <label>{{localize "VAGABOND.UI.Labels.SpellAmount"}}</label>
          <input type='number'
            name='{{arrayPath}}.{{itemIndex}}.spellAmount'
            value='{{grant.spellAmount}}'
            min='0' max='10'
            class='grants-num-input' />
          <span class='grants-hint'>{{localize "VAGABOND.UI.Hints.AmountHint"}}</span>
        </div>
        <div class='grants-list-section'>
          <label>{{localize "VAGABOND.UI.Labels.SpellPool"}} <span class='text-muted text-sm'>({{localize "VAGABOND.UI.Hints.EmptyForAny"}})</span></label>
          {{#if enrichedGrant.enrichedSpells.length}}
            <ul class='grants-list'>
              {{#each enrichedGrant.enrichedSpells as |spell spellIndex|}}
                <li class='grant-tag'>
                  <img src='{{spell.img}}' alt='{{spell.name}}' class='grant-tag-icon' />
                  <span class='grant-tag-label'>{{spell.name}}</span>
                  <a class='grant-tag-remove'
                    data-action='removeGrantSpell'
                    data-array-path='{{../arrayPath}}'
                    data-item-index='{{../itemIndex}}'
                    data-spell-index='{{spellIndex}}'>
                    <i class='fas fa-times'></i>
                  </a>
                </li>
              {{/each}}
            </ul>
          {{/if}}
          {{#if editable}}
            <div class='grants-add-row'>
              <select class='grants-select'
                data-array-path='{{arrayPath}}'
                data-item-index='{{itemIndex}}'
                data-grant-type='spell'>
                <option value=''>— Select Spell —</option>
              </select>
              <button type='button' class='btn-sm'
                data-action='addGrantSpell'
                data-array-path='{{arrayPath}}'
                data-item-index='{{itemIndex}}'>
                <i class='fas fa-plus'></i>
              </button>
            </div>
          {{/if}}
        </div>
      </div>
    </div>
  </div>

  {{! ── PERKS ───────────────────────────────────────────────────────────── }}
  <div class='accordion-item collapsed' data-accordion-id='grant-{{itemIndex}}-perks'>
    <div class='accordion-header' data-action='toggleAccordion'>
      <i class='accordion-icon fas fa-chevron-right'></i>
      <strong>{{localize "VAGABOND.UI.Sections.Perks"}}</strong>
    </div>
    <div class='accordion-content'>
      <div class='grants-accordion-body'>
        <div class='grants-row'>
          <label>{{localize "VAGABOND.UI.Labels.PerkAmount"}}</label>
          <input type='number'
            name='{{arrayPath}}.{{itemIndex}}.perkAmount'
            value='{{grant.perkAmount}}'
            min='0' max='10'
            class='grants-num-input' />
          <span class='grants-hint'>{{localize "VAGABOND.UI.Hints.AmountHint"}}</span>
        </div>
        <div class='grants-row'>
          <label>{{localize "VAGABOND.UI.Labels.IgnorePerkPrereqs"}}</label>
          <select name='{{arrayPath}}.{{itemIndex}}.ignorePerkPrereqs'>
            <option value='none' {{#if (eq grant.ignorePerkPrereqs 'none')}}selected{{/if}}>{{localize "VAGABOND.UI.Labels.IgnorePerkPrereqsNone"}}</option>
            <option value='all' {{#if (eq grant.ignorePerkPrereqs 'all')}}selected{{/if}}>{{localize "VAGABOND.UI.Labels.IgnorePerkPrereqsAll"}}</option>
            <option value='stats' {{#if (eq grant.ignorePerkPrereqs 'stats')}}selected{{/if}}>{{localize "VAGABOND.UI.Labels.IgnorePerkPrereqsStats"}}</option>
          </select>
          <span class='grants-hint'>{{localize "VAGABOND.UI.Hints.IgnorePerkPrereqsHint"}}</span>
        </div>
        <div class='grants-list-section'>
          <label>{{localize "VAGABOND.UI.Labels.PerkPool"}} <span class='text-muted text-sm'>({{localize "VAGABOND.UI.Hints.EmptyForAny"}})</span></label>
          {{#if enrichedGrant.enrichedPerks.length}}
            <ul class='grants-list'>
              {{#each enrichedGrant.enrichedPerks as |perk perkIndex|}}
                <li class='grant-tag'>
                  <img src='{{perk.img}}' alt='{{perk.name}}' class='grant-tag-icon' />
                  <span class='grant-tag-label'>{{perk.name}}</span>
                  <a class='grant-tag-remove'
                    data-action='removeGrantPerk'
                    data-array-path='{{../arrayPath}}'
                    data-item-index='{{../itemIndex}}'
                    data-perk-index='{{perkIndex}}'>
                    <i class='fas fa-times'></i>
                  </a>
                </li>
              {{/each}}
            </ul>
          {{else}}
            <p class='text-info text-sm'><i class='fas fa-info-circle'></i> Any perk allowed</p>
          {{/if}}
          {{#if editable}}
            <div class='grants-add-row'>
              <select class='grants-select'
                data-array-path='{{arrayPath}}'
                data-item-index='{{itemIndex}}'
                data-grant-type='perk'>
                <option value=''>— Select Perk —</option>
              </select>
              <button type='button' class='btn-sm'
                data-action='addGrantPerk'
                data-array-path='{{arrayPath}}'
                data-item-index='{{itemIndex}}'>
                <i class='fas fa-plus'></i>
              </button>
            </div>
          {{/if}}
        </div>
      </div>
    </div>
  </div>

  {{! ── GRANTED ITEMS (created equipped when gained, e.g. Breath Attack) ─ }}
  <div class='accordion-item collapsed' data-accordion-id='grant-{{itemIndex}}-items'>
    <div class='accordion-header' data-action='toggleAccordion'>
      <i class='accordion-icon fas fa-chevron-right'></i>
      <strong>{{localize "VAGABOND.UI.Sections.GrantedItems"}}</strong>
    </div>
    <div class='accordion-content'>
      <div class='grants-accordion-body'>
        <div class='item-grant-drop-zone'
          data-array-path='{{arrayPath}}'
          data-item-index='{{itemIndex}}'>
          {{#if enrichedGrant.enrichedItems.length}}
            <ul class='grants-list'>
              {{#each enrichedGrant.enrichedItems as |granted grantIndex|}}
                <li class='grant-tag'>
                  <img src='{{granted.img}}' alt='{{granted.name}}' class='grant-tag-icon' />
                  <span class='grant-tag-label'>{{granted.name}}</span>
                  {{#if ../editable}}
                    <a class='grant-tag-remove'
                      data-action='removeGrantItem'
                      data-array-path='{{../arrayPath}}'
                      data-item-index='{{../itemIndex}}'
                      data-grant-index='{{grantIndex}}'>
                      <i class='fas fa-times'></i>
                    </a>
                  {{/if}}
                </li>
              {{/each}}
            </ul>
          {{/if}}
          <p class='drop-hint text-muted'>{{localize "VAGABOND.UI.Hints.DropGrantedItem"}}</p>
        </div>

        {{! Item choice groups: the player picks Count items of the pool (Draken Breath Attack element) }}
        <div class='grants-choice-groups'>
          <div class='grants-choice-header'>
            <label>{{localize "VAGABOND.ItemChoice.Groups"}}</label>
            {{#if editable}}
              <button type='button' class='btn-sm'
                data-action='addGrantItemChoiceGroup'
                data-array-path='{{arrayPath}}'
                data-item-index='{{itemIndex}}'>
                <i class='fas fa-plus'></i> {{localize "VAGABOND.UI.Buttons.AddChoiceGroup"}}
              </button>
            {{/if}}
          </div>
          {{#each enrichedGrant.enrichedItemChoices as |choice choiceIndex|}}
            <div class='choice-group-card'>
              <div class='choice-group-header'>
                <strong>{{localize "VAGABOND.UI.Labels.Group"}} {{add choiceIndex 1}}</strong>
                {{#if ../editable}}
                  <a data-action='removeGrantItemChoiceGroup'
                    data-array-path='{{../arrayPath}}'
                    data-item-index='{{../itemIndex}}'
                    data-choice-index='{{choiceIndex}}'
                    class='text-danger'>
                    <i class='fas fa-trash'></i>
                  </a>
                {{/if}}
              </div>
              <div class='grants-row'>
                <label>{{localize "VAGABOND.UI.Labels.Count"}}</label>
                <input type='number'
                  name='{{../arrayPath}}.{{../itemIndex}}.itemChoices.{{choiceIndex}}.count'
                  value='{{choice.count}}'
                  min='1' max='10'
                  class='grants-num-input' />
                <input type='text'
                  name='{{../arrayPath}}.{{../itemIndex}}.itemChoices.{{choiceIndex}}.label'
                  value='{{choice.label}}'
                  placeholder='{{localize "VAGABOND.ItemChoice.LabelPlaceholder"}}'
                  class='grants-label-input' />
              </div>
              <div class='item-grant-drop-zone'
                data-array-path='{{../arrayPath}}'
                data-item-index='{{../itemIndex}}'
                data-choice-index='{{choiceIndex}}'>
                {{#if choice.items.length}}
                  <ul class='grants-list'>
                    {{#each choice.items as |granted grantIndex|}}
                      <li class='grant-tag'>
                        <img src='{{granted.img}}' alt='{{granted.name}}' class='grant-tag-icon' />
                        <span class='grant-tag-label'>{{granted.name}}</span>
                        {{#if ../../editable}}
                          <a class='grant-tag-remove'
                            data-action='removeGrantItem'
                            data-array-path='{{../../arrayPath}}'
                            data-item-index='{{../../itemIndex}}'
                            data-choice-index='{{choiceIndex}}'
                            data-grant-index='{{grantIndex}}'>
                            <i class='fas fa-times'></i>
                          </a>
                        {{/if}}
                      </li>
                    {{/each}}
                  </ul>
                {{/if}}
                <p class='drop-hint text-muted'>{{localize "VAGABOND.ItemChoice.DropHint"}}</p>
              </div>
            </div>
          {{/each}}
        </div>
      </div>
    </div>
  </div>

  {{! ── EFFECT CHOICES (ancestry traits only): pick N of the item's own effects ── }}
  {{#unless isClassFeature}}
  <div class='accordion-item collapsed' data-accordion-id='grant-{{itemIndex}}-effects'>
    <div class='accordion-header' data-action='toggleAccordion'>
      <i class='accordion-icon fas fa-chevron-right'></i>
      <strong>{{localize "VAGABOND.Grants.EffectChoices.Title"}}</strong>
    </div>
    <div class='accordion-content'>
      <div class='grants-accordion-body'>
        <div class='grants-choice-groups'>
          <div class='grants-choice-header'>
            <label>{{localize "VAGABOND.ItemChoice.Groups"}}</label>
            {{#if editable}}
              <button type='button' class='btn-sm'
                data-action='addGrantEffectChoiceGroup'
                data-array-path='{{arrayPath}}'
                data-item-index='{{itemIndex}}'>
                <i class='fas fa-plus'></i> {{localize "VAGABOND.UI.Buttons.AddChoiceGroup"}}
              </button>
            {{/if}}
          </div>
          <span class='grants-hint'>{{localize "VAGABOND.Grants.EffectChoices.Hint"}}</span>

          {{#each grant.effectChoices as |choice choiceIndex|}}
            <div class='choice-group-card'>
              <div class='choice-group-header'>
                <strong>{{localize "VAGABOND.UI.Labels.Group"}} {{add choiceIndex 1}}</strong>
                {{#if ../editable}}
                  <a data-action='removeGrantEffectChoiceGroup'
                    data-array-path='{{../arrayPath}}'
                    data-item-index='{{../itemIndex}}'
                    data-choice-index='{{choiceIndex}}'
                    class='text-danger'>
                    <i class='fas fa-trash'></i>
                  </a>
                {{/if}}
              </div>
              <div class='grants-row'>
                <label>{{localize "VAGABOND.UI.Labels.Count"}}</label>
                <input type='number'
                  name='{{../arrayPath}}.{{../itemIndex}}.effectChoices.{{choiceIndex}}.count'
                  value='{{choice.count}}'
                  min='1' max='10'
                  class='grants-num-input' />
                <input type='text'
                  name='{{../arrayPath}}.{{../itemIndex}}.effectChoices.{{choiceIndex}}.label'
                  value='{{choice.label}}'
                  placeholder='{{localize "VAGABOND.ItemChoice.LabelPlaceholder"}}'
                  class='grants-label-input' />
              </div>
              <div class='skill-pool-checkboxes'>
                {{#each @root.itemEffects as |fx|}}
                  <label class='skill-checkbox-label'>
                    <input type='checkbox'
                      name='{{../../arrayPath}}.{{../../itemIndex}}.effectChoices.{{choiceIndex}}.pool'
                      value='{{fx.id}}'
                      {{#if (contains choice.pool fx.id)}}checked{{/if}}
                      {{#unless ../../editable}}disabled{{/unless}} />
                    <span>{{fx.name}}</span>
                  </label>
                {{else}}
                  <small class='text-muted'>{{localize "VAGABOND.Grants.EffectChoices.NoEffects"}}</small>
                {{/each}}
              </div>
            </div>
          {{/each}}
        </div>
      </div>
    </div>
  </div>
  {{/unless}}

  {{! ── ALCHEMY FORMULAS (class features only) ─────────────────────────── }}
  {{#if isClassFeature}}
  <div class='accordion-item collapsed' data-accordion-id='grant-{{itemIndex}}-formulas'>
    <div class='accordion-header' data-action='toggleAccordion'>
      <i class='accordion-icon fas fa-chevron-right'></i>
      <strong>{{localize "VAGABOND.UI.Sections.Formulas"}}</strong>
    </div>
    <div class='accordion-content'>
      <div class='grants-accordion-body'>
        <div class='grants-row'>
          <label>{{localize "VAGABOND.UI.Labels.FormulaAmount"}}</label>
          <input type='number'
            name='{{arrayPath}}.{{itemIndex}}.formulaAmount'
            value='{{grant.formulaAmount}}'
            min='0' max='10'
            class='grants-num-input' />
          <span class='grants-hint'>{{localize "VAGABOND.UI.Hints.FormulaAmountHint"}}</span>
        </div>
        <div class='grants-row'>
          <label>{{localize "VAGABOND.UI.Labels.FormulaValueCap"}}</label>
          <input type='text'
            name='{{arrayPath}}.{{itemIndex}}.formulaValueCap'
            value='{{grant.formulaValueCap}}'
            class='grants-num-input' />
          <span class='grants-hint'>{{localize "VAGABOND.UI.Hints.FormulaValueCapHint"}}</span>
        </div>
      </div>
    </div>
  </div>
  {{/if}}

  {{! ── ACTION BUTTON ──────────────────────────────────────────────────── }}
  <div class='accordion-item collapsed' data-accordion-id='grant-{{itemIndex}}-action'>
    <div class='accordion-header' data-action='toggleAccordion'>
      <i class='accordion-icon fas fa-chevron-right'></i>
      <strong>{{localize "VAGABOND.FeatureAction.Section"}}</strong>
    </div>
    <div class='accordion-content'>
      <div class='grants-accordion-body'>
        <div class='grants-row'>
          <label>{{localize "VAGABOND.FeatureAction.Enabled"}}</label>
          <input type='checkbox' name='{{arrayPath}}.{{itemIndex}}.action.enabled' {{#if grant.action.enabled}}checked{{/if}} />
          <span class='grants-hint'>{{localize "VAGABOND.FeatureAction.Hint"}}</span>
        </div>
        <div class='grants-row'>
          <label>{{localize "VAGABOND.FeatureAction.Label"}}</label>
          <input type='text' name='{{arrayPath}}.{{itemIndex}}.action.label' value='{{grant.action.label}}' />
        </div>
        <div class='grants-row'>
          <label>{{localize "VAGABOND.FeatureAction.Icon"}}</label>
          <input type='text' name='{{arrayPath}}.{{itemIndex}}.action.icon' value='{{grant.action.icon}}' placeholder='music' />
        </div>
        <div class='grants-row'>
          <label>{{localize "VAGABOND.FeatureAction.RunAsGM"}}</label>
          <input type='checkbox' name='{{arrayPath}}.{{itemIndex}}.action.runAsGM' {{#if grant.action.runAsGM}}checked{{/if}} />
        </div>
        <div class='grants-row'>
          <label>{{localize "VAGABOND.FeatureAction.MacroUuid"}}</label>
          <input type='text' name='{{arrayPath}}.{{itemIndex}}.action.uuid' value='{{grant.action.uuid}}' placeholder='Macro.xxxxxxxx' />
        </div>
        <div class='grants-row'>
          <label>{{localize "VAGABOND.FeatureAction.Script"}}</label>
          <textarea name='{{arrayPath}}.{{itemIndex}}.action.command' rows='4' class='macro-command-input'>{{grant.action.command}}</textarea>
        </div>
      </div>
    </div>
  </div>

</div>
