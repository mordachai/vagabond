{{! Container Details Tab }}
<section
  class='tab details {{tab.cssClass}}{{#if system.locked}} container-locked{{/if}}'
  data-group='primary'
  data-tab='details'
>
  <div class='equipment-item-content'>
    {{! Unlocked: treasure + description editor. Locked: treasure moves to the header, no description }}
    {{#unless system.locked}}
    {{> 'systems/vagabond/templates/item/parts/container-treasure.hbs'}}
    <div class='form-group'>
      <label class='resource-label'>{{localize 'VAGABOND.Item.base.FIELDS.description.label'}}</label>
      <div class='equipment-description'>
        {{#if editable}}
          <prose-mirror name="system.description" data-document-uuid="{{item.uuid}}" value="{{system.description}}" toggled="true">
            {{{enriched.description}}}
          </prose-mirror>
        {{else}}
          <div>{{{enriched.description}}}</div>
        {{/if}}
      </div>
    </div>
    {{/unless}}

    {{#if canDeployConstruct}}
      <button type='button' class='container-deploy-construct' data-action='deployConstruct' data-tooltip='{{localize "VAGABOND.UI.Buttons.DeployConstructHint"}}'>
        <i class='fas fa-horse'></i> {{localize "VAGABOND.UI.Buttons.DeployConstruct"}}
      </button>
    {{/if}}

    {{! Container Configuration (only in unlocked mode) }}
    {{#unless system.locked}}
      <div class='form-group'>
        <label class='resource-label'>{{localize "VAGABOND.UI.Sections.ContainerConfig"}}</label>
        <p class='field-hint'>{{localize "VAGABOND.UI.Labels.ContainerConfigHint"}}</p>
      </div>
    {{/unless}}

    {{!-- Filter bar --}}
    <div class="container-search-header">
        <div class="search-field">
            <i class="fas fa-search"></i>
            <input type="text" class="container-search" placeholder="{{localize 'VAGABOND.UI.Labels.SearchItemsPlaceholder'}}" spellcheck="false">
        </div>
        <div class="item-counter">
            {{localize "VAGABOND.UI.Labels.Items"}}: <span id="visible-count">{{containerCount}}</span> / <span id="total-count">{{containerCount}}</span>
        </div>
    </div>
    {{! Container Items List: type sections (accordions, open by default); a name opens its details }}
    <div class='form-group' data-drop-container='true'>
      {{#if containerCount}}
        <div class='container-items-list'>
          <div class='ci-columns'>
            <span class='ci-col-name'>{{localize 'VAGABOND.UI.Labels.ContainerList.Item'}}</span>
            <span>{{localize 'VAGABOND.UI.Labels.ContainerList.Qty'}}</span>
            <span>{{localize 'VAGABOND.UI.Labels.ContainerList.Damage'}}</span>
            <span>{{localize 'VAGABOND.UI.Labels.ContainerList.Slots'}}</span>
            <span>{{localize 'VAGABOND.UI.Labels.ContainerList.Value'}}</span>
            <span></span>
          </div>
          {{#each containerGroups}}
          <div class='ci-group{{#if closed}} closed{{/if}}' data-group-key='{{key}}'>
            <button type='button' class='ci-group-title' data-action='toggleContainerGroup'>
              <i class='ci-group-icon fas fa-chevron-down'></i>
              <span class='ci-group-label'>{{label}}</span>
              <span class='ci-group-count'>{{items.length}}</span>
            </button>
            <div class='ci-group-body'>
              <div class='ci-group-inner'>
                {{#each items}}
                <div class='ci-item draggable{{#if open}} open{{/if}}' data-item-index='{{index}}' data-entry-key='{{key}}' draggable='true'>
                  <div class='ci-row'>
                    <img class='ci-img' src='{{img}}' alt='' data-action='openContainerItem' data-tooltip='{{localize "VAGABOND.UI.Labels.ContainerList.Open"}}'>
                    <button type='button' class='ci-name' data-action='toggleContainerItem'>
                      <span class='ci-name-text'>{{name}}</span>
                    </button>
                    <span class='ci-qty'>{{quantity}}</span>
                    <span class='ci-dmg'>{{damage}}</span>
                    <span class='ci-slots'{{#if slotsHint}} data-tooltip='{{slotsHint}}'{{/if}}>{{slots}}</span>
                    <span class='ci-value'>{{value}}</span>
                    <button type='button' class='ci-menu' data-action='containerItemMenu' data-tooltip='{{localize "VAGABOND.UI.Labels.ContainerList.Menu"}}'>
                      <i class='fas fa-ellipsis-vertical'></i>
                    </button>
                  </div>
                  <div class='ci-detail'><div class='ci-detail-inner'></div></div>
                </div>
                {{/each}}
              </div>
            </div>
          </div>
          {{/each}}
        </div>
      {{else}}
        <div class='container-empty-state' data-drop-container='true'>
          <p><i class='fas fa-inbox'></i> {{localize "VAGABOND.UI.Labels.EmptyContainer"}}</p>
          <p class='hint'>{{localize "VAGABOND.UI.Labels.DragItemsHint"}}</p>
        </div>
      {{/if}}
    </div>
  </div>
</section>
