{{! Ancestry Details Tab - Single scrolling container }}
<section
  class='tab details {{tab.cssClass}}'
  data-group='primary'
  data-tab='details'
>
  {{#if system.locked}}
    {{! Locked: read view — description, then each Trait with what it grants }}
    <div class='ancestry-read'>
      {{#if system.description}}
        <div class='ancestry-read-desc'>{{{enrichedDescription}}}</div>
      {{/if}}

      <h3 class='ancestry-read-title'>{{localize "VAGABOND.UI.Sections.Traits"}}</h3>
      {{#each enrichedTraits as |trait|}}
        <article class='ancestry-trait-card'>
          <header class='trait-title'>{{trait.name}}</header>
          {{#if trait.description}}
            <div class='ancestry-trait-text'>{{{trait.enrichedDescription}}}</div>
          {{/if}}
          {{#if trait.grantRows.length}}
            <ul class='grant-summary'>
              {{#each trait.grantRows as |row|}}
                <li class='grant-summary-row'>
                  <div class='grant-summary-head'>
                    <i class='{{row.icon}}'></i>
                    <span class='grant-summary-label'>{{row.label}}</span>
                    {{#if row.text}}<span class='grant-summary-text'>{{row.text}}</span>{{/if}}
                    {{#if row.note}}<em class='grant-summary-note'>{{row.note}}</em>{{/if}}
                    {{#if row.choose}}
                      <button type='button' class='grant-summary-choose' data-action='chooseTraitEffects'>
                        {{localize "VAGABOND.Grants.Summary.ChooseButton"}}
                      </button>
                    {{/if}}
                  </div>
                  {{#if row.refs.length}}
                    <div class='grant-refs'>
                      {{#each row.refs as |ref|}}
                        <a class='content-link grant-ref' draggable='true' data-link data-uuid='{{ref.uuid}}' data-tooltip='{{ref.name}}'>
                          <img src='{{ref.img}}' alt='' /><span>{{ref.name}}</span>
                        </a>
                      {{/each}}
                    </div>
                  {{/if}}
                </li>
              {{/each}}
            </ul>
          {{/if}}
        </article>
      {{else}}
        <p class='text-muted'>{{localize "VAGABOND.Grants.Summary.NoTraits"}}</p>
      {{/each}}
    </div>
  {{else}}
    {{! Description Section }}
    <div>
      <label class='resource-label'>{{localize 'VAGABOND.Item.Tabs.Description'}}</label>
      <div class='ancestry-description'>
        {{#if editable}}
          <prose-mirror name="system.description" data-document-uuid="{{item.uuid}}" value="{{system.description}}" toggled="true">
            {{{enrichedDescription}}}
          </prose-mirror>
        {{else}}
          <div>{{{enrichedDescription}}}</div>
        {{/if}}
      </div>
    </div>

    {{! Traits Section }}
    <div class='traits-section mt-20'>
      <div class='title-with-button'>
        <h3>{{localize "VAGABOND.UI.Sections.Traits"}}</h3>
        {{#if editable}}
          <button
            type='button'
            class='item-control btn-sm'
            data-action='addTrait'
            data-tooltip='{{localize "VAGABOND.UI.Labels.AddNewTraitTooltip"}}'
          >
            <i class='fas fa-plus'></i> Add Trait
          </button>
        {{/if}}
      </div>

      <ol class='items-list'>
          {{#if system.traits.length}}
            {{#each system.traits as |trait index|}}
            {{#with (lookup @root.enrichedTraits index) as |enrichedTrait|}}
            <li class='item' data-trait-index='{{index}}'>
              {{! First row: Trait name + delete button }}
              <div class='flexrow'>
                {{#if @root.editable}}
                  <div class='item-name'>
                    <input
                      type='text'
                      name='system.traits.{{index}}.name'
                      value='{{trait.name}}'
                      placeholder='{{localize "VAGABOND.UI.Labels.TraitNamePlaceholder"}}'
                      class='trait-title'
                    />
                  </div>
                  <div class='item-controls'>
                    <a class='item-control'
                      data-action='removeTrait'
                      data-trait-index='{{index}}'
                      data-tooltip='{{localize "VAGABOND.UI.Labels.RemoveTraitTooltip"}}'
                    >
                      <i class='fas fa-trash'></i>
                    </a>
                  </div>
                {{else}}
                  <div class='item-name'>
                    <strong class='trait-title'>{{trait.name}}</strong>
                  </div>
                {{/if}}
              </div>

              {{! Second row: Description (rich text, like Class features) }}
              <div class='trait-description'>
                {{#if @root.editable}}
                  <prose-mirror
                    name='system.traits.{{index}}.description'
                    data-document-uuid='{{@root.item.uuid}}'
                    value='{{trait.description}}'
                    toggled='true'
                  >
                    {{{enrichedTrait.enrichedDescription}}}
                  </prose-mirror>
                {{else}}
                  {{#if enrichedTrait.enrichedDescription}}
                    <div>{{{enrichedTrait.enrichedDescription}}}</div>
                  {{/if}}
                {{/if}}
              </div>

              {{! Grants configuration (edit mode only) }}
              {{#if @root.editable}}
                {{> "systems/vagabond/templates/item/parts/grants-config.hbs"
                  grant=trait
                  arrayPath="system.traits"
                  itemIndex=index
                  enrichedGrant=enrichedTrait
                  config=@root.config
                  editable=@root.editable}}
              {{/if}}

            {{/with}}
            </li>
            {{/each}}
          {{else}}
            <li>
              No traits defined.{{#if editable}} Click the + button to add one.{{/if}}
            </li>
          {{/if}}
      </ol>
    </div>
  {{/if}}
</section>
