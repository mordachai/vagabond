{{! Spell Details Tab }}
<section
  class='tab details {{tab.cssClass}} {{#if system.locked}}spell-locked-view{{/if}}'
  data-group='primary'
  data-tab='details'
>
  {{#if system.locked}}
    {{! ===== LOCKED VIEW ===== }}
    <div class='equipment-locked-content'>
      {{! Damage Type }}
      {{#unless (eq system.damageType '-')}}
        <div class='locked-section'>
          <h3 class='section-header'>{{localize "VAGABOND.UI.Labels.DamageBase"}}</h3>
          <div class='locked-stats-grid'>
            <div class='locked-stat'>
              <span class='stat-label'>{{localize "VAGABOND.UI.Labels.DamageBase"}}:</span>
              <span class='stat-value'>{{localize (lookup config.damageTypes system.damageType)}}</span>
            </div>
          </div>
        </div>
      {{/unless}}

      {{! Duration }}
      {{#if system.duration}}
        <div class='locked-section'>
          <div class='locked-stat'>
            <span class='stat-label'>{{localize 'VAGABOND.Item.Spell.FIELDS.duration.label'}}:</span>
            <span class='stat-value'>{{system.duration}}</span>
          </div>
        </div>
      {{/if}}

      {{! Exploding Dice }}
      {{#if system.canExplode}}
        <div class='locked-section'>
          <div class='locked-stat'>
            <span class='stat-label'>{{localize "VAGABOND.UI.Labels.ExplodingDice"}}:</span>
            <span class='stat-value'>{{system.explodeValues}}</span>
          </div>
        </div>
      {{/if}}

      {{! No Roll Required }}
      {{#if system.noRollRequired}}
        <div class='locked-section'>
          <div class='locked-stat'>
            <span class='stat-label'>{{localize "VAGABOND.UI.Labels.NoRollRequired"}}:</span>
            <span class='stat-value'>{{localize "VAGABOND.UI.Labels.Yes"}}</span>
          </div>
        </div>
      {{/if}}

      {{! Target picker }}
      {{#if (or system.targetBeings system.targetObjects)}}
        <div class='locked-section'>
          <div class='locked-stat'>
            <span class='stat-label'>{{localize "VAGABOND.Item.Spell.FIELDS.pickTargets.label"}}:</span>
            <span class='stat-value'>
              {{#if system.targetBeings}}{{localize "VAGABOND.Item.Spell.FIELDS.targetBeings.label"}}{{/if}}
              {{#if (and system.targetBeings system.targetObjects)}}·{{/if}}
              {{#if system.targetObjects}}{{localize "VAGABOND.Item.Spell.FIELDS.targetObjects.label"}}{{/if}}
            </span>
          </div>
        </div>
      {{/if}}

      {{! Animation preview (Sequencer) }}
      {{#if spellFx}}
        <div class='locked-section'>
          <div class='locked-stat locked-stat--row'>
            <span class='stat-label'>{{localize "VAGABOND.UI.Labels.Anim"}}:</span>
            <span class='stat-value spell-fx-locked-icons'>
              <i class='fas fa-film' data-action='previewSpellFx'
                 data-tooltip='{{spellFx.schoolLabel}} — {{localize "VAGABOND.SpellFx.ClickToPreview"}}'></i>
              <span>{{spellFx.schoolLabel}}</span>
            </span>
          </div>
        </div>
      {{/if}}

{{> "systems/vagabond/templates/item/parts/macro-config.hbs" system=system macroNames=macroNames autoRun=true}}
    </div>
  {{else}}
    {{! ===== UNLOCKED VIEW (EDITABLE) ===== }}
    <div class='spell-item-content'>
      <div class="item-section-box">
        <div class="item-section-label">{{localize "VAGABOND.UI.Labels.SpellDetails"}}</div>
        {{! Damage Base and Duration - Same Line }}
        <div class='flexrow gap-8'>
          <div class='form-group flex-1'>
            <label class='resource-label'>{{localize "VAGABOND.UI.Labels.DamageBase"}}</label>
            {{> "systems/vagabond/templates/shared/damage-type-select.hbs"
                name="system.damageType"
                selected=system.damageType
                includeNone=true
                config=config}}
          </div>
          <div class='form-group flex-2'>
            <label class='resource-label'>{{localize 'VAGABOND.Item.Spell.FIELDS.duration.label'}}</label>
            <input
              type='text'
              name='system.duration'
              value='{{system.duration}}'
              placeholder='{{localize "VAGABOND.Item.Spell.FIELDS.duration.hint"}}'
            />
          </div>
        </div>

        {{! Exploding Dice Configuration }}
        <div class='form-group'>
          <label class='resource-label'>{{localize "VAGABOND.UI.Labels.ExplodingDice"}}</label>
          <div class='grid grid-2col gap-8'>
            <div class='explode-checkbox-field'>
              <label class='checkbox-label'>
                <input
                  type='checkbox'
                  name='system.canExplode'
                  {{#if system.canExplode}}checked{{/if}}
                  data-dtype='Boolean'
                />
                <span>{{localize "VAGABOND.UI.Labels.CanExplode"}}</span>
              </label>
            </div>
            <div class='explode-values-field'>
              <label class='resource-label'>{{localize "VAGABOND.UI.Labels.ExplodeOn"}}</label>
              <input
                type='text'
                name='system.explodeValues'
                value='{{system.explodeValues}}'
                data-dtype='String'
                placeholder='e.g., 1,4'
                {{#unless system.canExplode}}disabled{{/unless}}
              />
            </div>
          </div>
        </div>

        {{! No Roll Required Checkbox }}
        <div class='form-group'>
          <label class='checkbox-label'>
            <input
              type='checkbox'
              name='system.noRollRequired'
              {{#if system.noRollRequired}}checked{{/if}}
              data-dtype='Boolean'
            />
            <span>{{localize "VAGABOND.UI.Labels.NoRollRequired"}}</span>
          </label>
          <p class='notes'>{{localize "VAGABOND.UI.Labels.NoRollRequiredHint"}}</p>
        </div>

        {{! No Free Die Checkbox }}
        <div class='form-group'>
          <label class='checkbox-label'>
            <input
              type='checkbox'
              name='system.noFreeDie'
              {{#if system.noFreeDie}}checked{{/if}}
              data-dtype='Boolean'
            />
            <span>{{localize "VAGABOND.UI.Labels.NoFreeDie"}}</span>
          </label>
          <p class='notes'>{{localize "VAGABOND.UI.Labels.NoFreeDieHint"}}</p>
        </div>

        {{! Uses Dice Scaling Checkbox }}
        <div class='form-group'>
          <label class='checkbox-label'>
            <input
              type='checkbox'
              name='system.usesDiceScaling'
              {{#if system.usesDiceScaling}}checked{{/if}}
              data-dtype='Boolean'
            />
            <span>{{localize "VAGABOND.UI.Labels.UsesDiceScaling"}}</span>
          </label>
          <p class='notes'>{{localize "VAGABOND.UI.Labels.UsesDiceScalingHint"}}</p>
        </div>

        {{! Target picker switches (SpellTargetPicker) }}
        <div class='form-group'>
          <label class='checkbox-label'>
            <input type='checkbox' name='system.targetBeings' {{#if system.targetBeings}}checked{{/if}} data-dtype='Boolean' />
            <span>{{localize "VAGABOND.Item.Spell.FIELDS.targetBeings.label"}}</span>
          </label>
          <p class='notes'>{{localize "VAGABOND.Item.Spell.FIELDS.targetBeings.hint"}}</p>
        </div>
        <div class='form-group'>
          <label class='checkbox-label'>
            <input type='checkbox' name='system.targetObjects' {{#if system.targetObjects}}checked{{/if}} data-dtype='Boolean' />
            <span>{{localize "VAGABOND.Item.Spell.FIELDS.targetObjects.label"}}</span>
          </label>
          <p class='notes'>{{localize "VAGABOND.Item.Spell.FIELDS.targetObjects.hint"}}</p>
        </div>
        <div class='form-group'>
          <label class='checkbox-label'>
            <input type='checkbox' name='system.focusOnCast' {{#if system.focusOnCast}}checked{{/if}} data-dtype='Boolean' />
            <span>{{localize "VAGABOND.Item.Spell.FIELDS.focusOnCast.label"}}</span>
          </label>
          <p class='notes'>{{localize "VAGABOND.Item.Spell.FIELDS.focusOnCast.hint"}}</p>
        </div>
        <div class='form-group'>
          <label class='checkbox-label'>
            <input type='checkbox' name='system.critNoFocus' {{#if system.critNoFocus}}checked{{/if}} data-dtype='Boolean' />
            <span>{{localize "VAGABOND.Item.Spell.FIELDS.critNoFocus.label"}}</span>
          </label>
          <p class='notes'>{{localize "VAGABOND.Item.Spell.FIELDS.critNoFocus.hint"}}</p>
        </div>
        <div class='form-group'>
          <label class='resource-label'>{{localize "VAGABOND.Item.Spell.FIELDS.focusUpkeep.label"}}</label>
          <input type='number' name='system.focusUpkeep.mana' value='{{system.focusUpkeep.mana}}' min='0' step='1' data-dtype='Number' />
          <p class='notes'>{{localize "VAGABOND.Item.Spell.FIELDS.focusUpkeep.hint"}}</p>
        </div>
        <div class='form-group'>
          <label class='checkbox-label'>
            <input type='checkbox' name='system.focusUpkeep.perTarget' {{#if system.focusUpkeep.perTarget}}checked{{/if}} data-dtype='Boolean' />
            <span>{{localize "VAGABOND.Item.Spell.FIELDS.focusUpkeep.perTarget.label"}}</span>
          </label>
          <p class='notes'>{{localize "VAGABOND.Item.Spell.FIELDS.focusUpkeep.perTarget.hint"}}</p>
        </div>
        <div class='form-group'>
          <label class='checkbox-label'>
            <input type='checkbox' name='system.focusUpkeep.onCast' {{#if system.focusUpkeep.onCast}}checked{{/if}} data-dtype='Boolean' />
            <span>{{localize "VAGABOND.Item.Spell.FIELDS.focusUpkeep.onCast.label"}}</span>
          </label>
          <p class='notes'>{{localize "VAGABOND.Item.Spell.FIELDS.focusUpkeep.onCast.hint"}}</p>
        </div>
        <div class='form-group'>
          <label class='checkbox-label'>
            <input type='checkbox' name='system.wardUpcast' {{#if system.wardUpcast}}checked{{/if}} data-dtype='Boolean' />
            <span>{{localize "VAGABOND.Item.Spell.FIELDS.wardUpcast.label"}}</span>
          </label>
          <p class='notes'>{{localize "VAGABOND.Item.Spell.FIELDS.wardUpcast.hint"}}</p>
        </div>

        {{! Conjure (ConjureHelper): what the hit macro system:spell.conjure calls forth }}
        <div class='form-group'>
          <label class='resource-label'>{{localize "VAGABOND.Item.Spell.FIELDS.conjure.kind.label"}}</label>
          <select name='system.conjure.kind'>
            <option value='' {{#unless system.conjure.kind}}selected{{/unless}}>-</option>
            <option value='beings' {{#if (eq system.conjure.kind 'beings')}}selected{{/if}}>{{localize "VAGABOND.Item.Spell.FIELDS.conjure.kind.beings"}}</option>
            <option value='items' {{#if (eq system.conjure.kind 'items')}}selected{{/if}}>{{localize "VAGABOND.Item.Spell.FIELDS.conjure.kind.items"}}</option>
          </select>
          <p class='notes'>{{localize "VAGABOND.Item.Spell.FIELDS.conjure.kind.hint"}}</p>
        </div>
        {{#if (eq system.conjure.kind 'beings')}}
        <div class='form-group'>
          <label class='resource-label'>{{localize "VAGABOND.Item.Spell.FIELDS.conjure.beingType.label"}}</label>
          <select name='system.conjure.beingType'>
            {{selectOptions config.beingTypes selected=system.conjure.beingType localize=true blank="-"}}
          </select>
        </div>
        <div class='form-group'>
          <label class='resource-label'>{{localize "VAGABOND.Item.Spell.FIELDS.conjure.budget.label"}}</label>
          <input type='text' name='system.conjure.budget' value='{{system.conjure.budget}}' placeholder='max(1, floor(@lvl / 2))' />
          <p class='notes'>{{localize "VAGABOND.Item.Spell.FIELDS.conjure.budget.hint"}}</p>
        </div>
        {{/if}}
        {{#if (eq system.conjure.kind 'items')}}
        <div class='form-group'>
          <label class='checkbox-label'>
            <input type='checkbox' name='system.conjure.forgeableOnly' {{#if system.conjure.forgeableOnly}}checked{{/if}} data-dtype='Boolean' />
            <span>{{localize "VAGABOND.Item.Spell.FIELDS.conjure.forgeableOnly.label"}}</span>
          </label>
          <p class='notes'>{{localize "VAGABOND.Item.Spell.FIELDS.conjure.forgeableOnly.hint"}}</p>
        </div>
        <div class='form-group'>
          <label class='resource-label'>{{localize "VAGABOND.Item.Spell.FIELDS.conjure.maxSlots.label"}}</label>
          <input type='number' name='system.conjure.maxSlots' value='{{system.conjure.maxSlots}}' min='0' step='1' data-dtype='Number' />
        </div>
        <div class='form-group'>
          <label class='resource-label'>{{localize "VAGABOND.Item.Spell.FIELDS.conjure.maxCost.label"}}</label>
          <div class='flexrow'>
            <input type='number' name='system.conjure.maxCost.gold' value='{{system.conjure.maxCost.gold}}' min='0' step='1' data-dtype='Number' data-tooltip='{{localize "VAGABOND.Currency.Gold.abbr"}}' />
            <input type='number' name='system.conjure.maxCost.silver' value='{{system.conjure.maxCost.silver}}' min='0' step='1' data-dtype='Number' data-tooltip='{{localize "VAGABOND.Currency.Silver.abbr"}}' />
            <input type='number' name='system.conjure.maxCost.copper' value='{{system.conjure.maxCost.copper}}' min='0' step='1' data-dtype='Number' data-tooltip='{{localize "VAGABOND.Currency.Copper.abbr"}}' />
          </div>
          <p class='notes'>{{localize "VAGABOND.Item.Spell.FIELDS.conjure.maxCost.hint"}}</p>
        </div>
        {{/if}}

        {{! Spell Surface (SpellSurface): what the hit macro system:spell.surface leaves on the map }}
        <div class='form-group'>
          <label class='checkbox-label'>
            <input type='checkbox' name='system.surface.enabled' {{#if system.surface.enabled}}checked{{/if}} data-dtype='Boolean' />
            <span>{{localize "VAGABOND.Item.Spell.FIELDS.surface.enabled.label"}}</span>
          </label>
          <p class='notes'>{{localize "VAGABOND.Item.Spell.FIELDS.surface.enabled.hint"}}</p>
        </div>
        {{#if system.surface.enabled}}
        <div class='form-group'>
          <label class='resource-label'>{{localize "VAGABOND.Item.Spell.FIELDS.surface.around.label"}}</label>
          <input type='number' name='system.surface.around' value='{{system.surface.around}}' min='0' max='3' step='1' data-dtype='Number' />
          <p class='notes'>{{localize "VAGABOND.Item.Spell.FIELDS.surface.around.hint"}}</p>
        </div>
        <div class='form-group'>
          <label class='checkbox-label'>
            <input type='checkbox' name='system.surface.difficult' {{#if system.surface.difficult}}checked{{/if}} data-dtype='Boolean' />
            <span>{{localize "VAGABOND.Item.Spell.FIELDS.surface.difficult.label"}}</span>
          </label>
          <p class='notes'>{{localize "VAGABOND.Item.Spell.FIELDS.surface.difficult.hint"}}</p>
        </div>
        <div class='form-group'>
          <label class='resource-label'>{{localize "VAGABOND.Item.Spell.FIELDS.surface.enterDamage.label"}}</label>
          <input type='text' name='system.surface.enterDamage' value='{{system.surface.enterDamage}}' placeholder='d6' />
          <p class='notes'>{{localize "VAGABOND.Item.Spell.FIELDS.surface.enterDamage.hint"}}</p>
        </div>
        <div class='form-group'>
          <label class='resource-label'>{{localize "VAGABOND.Item.Spell.FIELDS.surface.turnEndDamage.label"}}</label>
          <input type='text' name='system.surface.turnEndDamage' value='{{system.surface.turnEndDamage}}' placeholder='d6' />
          <p class='notes'>{{localize "VAGABOND.Item.Spell.FIELDS.surface.turnEndDamage.hint"}}</p>
        </div>
        <div class='form-group'>
          <label class='resource-label'>{{localize "VAGABOND.Item.Spell.FIELDS.surface.whileIn.label"}}</label>
          <select name='system.surface.whileIn'>
            <option value='' {{#unless system.surface.whileIn}}selected{{/unless}}>-</option>
            {{#each config.statusConditions as |label key|}}
              <option value='{{key}}' {{#if (eq ../system.surface.whileIn key)}}selected{{/if}}>{{localize label}}</option>
            {{/each}}
          </select>
          <p class='notes'>{{localize "VAGABOND.Item.Spell.FIELDS.surface.whileIn.hint"}}</p>
        </div>
        <div class='form-group'>
          <label class='checkbox-label'>
            <input type='checkbox' name='system.surface.obscure' {{#if system.surface.obscure}}checked{{/if}} data-dtype='Boolean' />
            <span>{{localize "VAGABOND.Item.Spell.FIELDS.surface.obscure.label"}}</span>
          </label>
          <p class='notes'>{{localize "VAGABOND.Item.Spell.FIELDS.surface.obscure.hint"}}</p>
        </div>
        <div class='form-group'>
          <label class='resource-label'>{{localize "VAGABOND.Item.Spell.FIELDS.surface.clip.label"}}</label>
          <input type='text' name='system.surface.clip' value='{{system.surface.clip}}' placeholder='jb2a.grease.dark_brown.loop' />
          <p class='notes'>{{localize "VAGABOND.Item.Spell.FIELDS.surface.clip.hint"}}</p>
        </div>
        <div class='form-group'>
          <label class='resource-label'>{{localize "VAGABOND.Item.Spell.FIELDS.surface.tint.label"}}</label>
          <input type='text' name='system.surface.tint' value='{{system.surface.tint}}' placeholder='#7fbf3f' />
          <p class='notes'>{{localize "VAGABOND.Item.Spell.FIELDS.surface.tint.hint"}}</p>
        </div>
        {{/if}}

        {{! Dice Scaling Label (only relevant when scaling is on) }}
        {{#if system.usesDiceScaling}}
        <div class='form-group'>
          <label class='resource-label'>{{localize "VAGABOND.UI.Labels.DiceScaleLabel"}}</label>
          <input
            type='text'
            name='system.diceScaleLabel'
            value='{{system.diceScaleLabel}}'
            placeholder='{{localize "VAGABOND.UI.Labels.DicePlaceholder"}}'
          />
        </div>
        {{/if}}

        {{! FX School (Sequencer) }}
        <div class='form-group'>
          <label class='resource-label'>{{localize "VAGABOND.Item.Spell.FxSchool.Label"}}</label>
          <select name='system.fxSchool' data-dtype='String'>
            {{#each config.fxSchools as |label key|}}
              <option value='{{key}}' {{#if (eq key ../system.fxSchool)}}selected{{/if}}>
                {{localize label}}
              </option>
            {{/each}}
          </select>
        </div>
      </div>{{! /item-section-box Spell Configuration }}

      {{! ===== STATUS & EFFECTS CONFIGURATION ===== }}
      <div class="item-section-box">
        <div class="item-section-label">{{localize 'VAGABOND.Status.StatusesEffectsTitle'}}</div>
      <details class='item-section-details' data-details-id='on-hit-effects'>
        <summary class='item-section-summary'>
          <i class='fas fa-chevron-right accordion-icon'></i>
          <span>{{localize 'VAGABOND.Status.OnHitEffects'}}</span>
        </summary>
        <div class='on-hit-effects-body'>
          {{#each system.causedStatuses as |entry index|}}
            <div class='caused-status-row' data-index='{{index}}'>
              <div class='caused-status-top'>
                <select name='system.causedStatuses.{{index}}.statusId' class='caused-status-select'>
                  <option value=''>{{localize 'VAGABOND.Status.SelectStatus'}}</option>
                  {{#each @root.config.statusConditions as |label key|}}
                    <option value='{{key}}' {{#if (eq ../statusId key)}}selected{{/if}}>{{localize label}}</option>
                  {{/each}}
                </select>
                <select name='system.causedStatuses.{{index}}.saveType' class='caused-status-save'>
                  <option value='any' {{#if (eq entry.saveType 'any')}}selected{{/if}}>{{localize 'VAGABOND.Status.Save.Any'}}</option>
                  <option value='none' {{#if (eq entry.saveType 'none')}}selected{{/if}}>{{localize 'VAGABOND.Status.Save.None'}}</option>
                  {{#each @root.config.homebrew.saves as |save|}}
                    <option value='{{save.key}}' {{#if (eq ../saveType save.key)}}selected{{/if}}>{{localize save.label}}</option>
                  {{/each}}
                </select>
                <select name='system.causedStatuses.{{index}}.duration' class='caused-status-duration'>
                  <option value='' {{#if (eq entry.duration '')}}selected{{/if}}>{{localize 'VAGABOND.Status.Duration.Permanent'}}</option>
                  <option value='focusing' {{#if (eq entry.duration 'focusing')}}selected{{/if}}>{{localize 'VAGABOND.Status.Duration.Focusing'}}</option>
                  {{#each @root.config.countdownDiceTypes as |diceKey|}}
                    <option value='{{diceKey}}' {{#if (eq ../duration diceKey)}}selected{{/if}}>C{{diceKey}}</option>
                  {{/each}}
                </select>
              </div>
              <div class='caused-status-bot'>
                <label class='caused-status-dmg-toggle' title='{{localize "VAGABOND.Status.CausesDamageHint"}}'>
                  <input type='checkbox' name='system.causedStatuses.{{index}}.tickDamageEnabled'
                    {{#if entry.tickDamageEnabled}}checked{{/if}}>
                  {{localize 'VAGABOND.Status.CausesDamage'}}
                </label>
                {{#if entry.tickDamageEnabled}}
                <select name='system.causedStatuses.{{index}}.damageType' class='caused-status-dtype'>
                  {{#each @root.config.damageTypes as |label key|}}
                    <option value='{{key}}' {{#if (eq ../damageType key)}}selected{{/if}}>{{localize label}}</option>
                  {{/each}}
                </select>
                <input type='text' name='system.causedStatuses.{{index}}.damageOnTick'
                  value='{{entry.damageOnTick}}' placeholder='{{localize "VAGABOND.Status.TickFormula"}}'
                  class='caused-status-tick'>
                {{!-- TODO: fatigueOnTick input — restore when re-enabling (see base-equipment.mjs for full checklist)
                <input type='number' name='system.causedStatuses.{{index}}.fatigueOnTick'
                  value='{{entry.fatigueOnTick}}' min='0' title='{{localize "VAGABOND.Status.FatigueOnTick"}}'
                  class='caused-status-fatigue-tick'>
                --}}
                {{/if}}
                <label class='caused-status-req' title='{{localize "VAGABOND.Status.RequiresDamageCastHint"}}'>
                  <input type='checkbox' name='system.causedStatuses.{{index}}.requiresDamage'
                    {{#if entry.requiresDamage}}checked{{/if}}>
                  {{localize 'VAGABOND.Status.RequiresDamageCastShort'}}
                </label>
                <button type='button' class='caused-status-remove' data-action='removeCausedStatus' data-index='{{index}}'>
                  <i class='fas fa-times'></i>
                </button>
              </div>
            </div>
          {{/each}}
          <button type='button' class='caused-status-add' data-action='addCausedStatus'>
            <i class='fas fa-plus'></i> {{localize 'VAGABOND.Status.AddEffect'}}
          </button>
        </div>
      </details>

      {{! ===== CRIT ON-HIT STATUS EFFECTS ===== }}
      <details class='item-section-details' data-details-id='crit-on-hit-effects'>
        <summary class='item-section-summary'>
          <i class='fas fa-chevron-right accordion-icon'></i>
          <span>{{localize 'VAGABOND.Status.CritOnHitEffects'}}</span>
        </summary>
        <div class='on-hit-effects-body'>
          {{#each system.critCausedStatuses as |entry index|}}
            <div class='caused-status-row' data-index='{{index}}'>
              <div class='caused-status-top'>
                <select name='system.critCausedStatuses.{{index}}.statusId' class='caused-status-select'>
                  <option value=''>{{localize 'VAGABOND.Status.SelectStatus'}}</option>
                  {{#each @root.config.statusConditions as |label key|}}
                    <option value='{{key}}' {{#if (eq ../statusId key)}}selected{{/if}}>{{localize label}}</option>
                  {{/each}}
                </select>
                <select name='system.critCausedStatuses.{{index}}.saveType' class='caused-status-save'>
                  <option value='any' {{#if (eq entry.saveType 'any')}}selected{{/if}}>{{localize 'VAGABOND.Status.Save.Any'}}</option>
                  <option value='none' {{#if (eq entry.saveType 'none')}}selected{{/if}}>{{localize 'VAGABOND.Status.Save.None'}}</option>
                  {{#each @root.config.homebrew.saves as |save|}}
                    <option value='{{save.key}}' {{#if (eq ../saveType save.key)}}selected{{/if}}>{{localize save.label}}</option>
                  {{/each}}
                </select>
                <select name='system.critCausedStatuses.{{index}}.duration' class='caused-status-duration'>
                  <option value='' {{#if (eq entry.duration '')}}selected{{/if}}>{{localize 'VAGABOND.Status.Duration.Permanent'}}</option>
                  <option value='focusing' {{#if (eq entry.duration 'focusing')}}selected{{/if}}>{{localize 'VAGABOND.Status.Duration.Focusing'}}</option>
                  {{#each @root.config.countdownDiceTypes as |diceKey|}}
                    <option value='{{diceKey}}' {{#if (eq ../duration diceKey)}}selected{{/if}}>C{{diceKey}}</option>
                  {{/each}}
                </select>
              </div>
              <div class='caused-status-bot'>
                <label class='caused-status-dmg-toggle' title='{{localize "VAGABOND.Status.CausesDamageHint"}}'>
                  <input type='checkbox' name='system.critCausedStatuses.{{index}}.tickDamageEnabled'
                    {{#if entry.tickDamageEnabled}}checked{{/if}}>
                  {{localize 'VAGABOND.Status.CausesDamage'}}
                </label>
                {{#if entry.tickDamageEnabled}}
                <select name='system.critCausedStatuses.{{index}}.damageType' class='caused-status-dtype'>
                  {{#each @root.config.damageTypes as |label key|}}
                    <option value='{{key}}' {{#if (eq ../damageType key)}}selected{{/if}}>{{localize label}}</option>
                  {{/each}}
                </select>
                <input type='text' name='system.critCausedStatuses.{{index}}.damageOnTick'
                  value='{{entry.damageOnTick}}' placeholder='{{localize "VAGABOND.Status.TickFormula"}}'
                  class='caused-status-tick'>
                {{!-- TODO: fatigueOnTick input — restore when re-enabling (see base-equipment.mjs for full checklist)
                <input type='number' name='system.critCausedStatuses.{{index}}.fatigueOnTick'
                  value='{{entry.fatigueOnTick}}' min='0' title='{{localize "VAGABOND.Status.FatigueOnTick"}}'
                  class='caused-status-fatigue-tick'>
                --}}
                {{/if}}
                <label class='caused-status-req' title='{{localize "VAGABOND.Status.RequiresDamageCastHint"}}'>
                  <input type='checkbox' name='system.critCausedStatuses.{{index}}.requiresDamage'
                    {{#if entry.requiresDamage}}checked{{/if}}>
                  {{localize 'VAGABOND.Status.RequiresDamageCastShort'}}
                </label>
                <button type='button' class='caused-status-remove' data-action='removeCritCausedStatus' data-index='{{index}}'>
                  <i class='fas fa-times'></i>
                </button>
              </div>
            </div>
          {{/each}}
          <button type='button' class='caused-status-add' data-action='addCritCausedStatus'>
            <i class='fas fa-plus'></i> {{localize 'VAGABOND.Status.AddCritEffect'}}
          </button>
        </div>
      </details>
      </div>{{! /item-section-box Status & Effects }}

      {{> "systems/vagabond/templates/item/parts/macro-config.hbs" system=system macroNames=macroNames autoRun=true}}
    </div>
  {{/if}}
</section>
