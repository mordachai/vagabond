<div class="downtime-panel">
  {{#*inline "dtTile"}}
    <button type="button" class="dt-tile {{#if selected}}is-selected{{/if}} {{#if blocked}}is-blocked{{/if}}"
            data-action="selectTile" data-key="{{key}}">
      <img src="{{icon}}" alt="">
      <span class="dt-tile-title">{{title}}</span>
      {{#if badgeIcon}}<span class="dt-badge {{#if zero}}is-zero{{/if}}" data-tooltip="{{badgeTooltip}}"><i class="{{badgeIcon}}"></i>{{badge}}</span>{{/if}}
    </button>
  {{/inline}}

  {{!-- Shift tracker: one 4-segment clock per Day, filled = Shifts left --}}
  <section class="dt-tracker">
    <div class="dt-clocks">
      {{#each tracker.clocks}}
        <img class="dt-clock {{#if partial}}is-partial{{/if}}" src="{{img}}" data-tooltip="{{tooltip}}" alt="">
      {{/each}}
    </div>
    <div class="dt-tracker-body">
      <div class="dt-tracker-count">
        <button type="button" class="dt-step" data-action="shiftRemove" {{#unless tracker.canRemove}}disabled{{/unless}}
                data-tooltip="{{localize 'VAGABOND.Downtime.Tracker.Remove'}}"><i class="fas fa-minus"></i></button>
        <span class="dt-left {{#if noShifts}}is-zero{{/if}}">{{localize "VAGABOND.Downtime.Tracker.Left" left=tracker.left shifts=tracker.shifts}}</span>
        <button type="button" class="dt-step" data-action="shiftAdd" {{#unless tracker.canAdd}}disabled{{/unless}}
                data-tooltip="{{localize 'VAGABOND.Downtime.Tracker.Add'}}"><i class="fas fa-plus"></i></button>
        <button type="button" class="dt-step dt-reset" data-action="shiftReset" {{#unless tracker.canReset}}disabled{{/unless}}
                data-tooltip="{{localize 'VAGABOND.Downtime.Tracker.Reset'}}"><i class="fas fa-rotate-left"></i></button>
      </div>
      <div class="dt-log">
        {{#each tracker.log}}<img src="{{img}}" data-tooltip="{{tooltip}}" alt="">{{else}}<span class="dt-log-empty">{{localize "VAGABOND.Downtime.Tracker.Intro"}}</span>{{/each}}
      </div>
    </div>
  </section>

  {{!-- ============ Activities (each takes a Shift) ============ --}}
  <h3 class="dt-section">{{localize "VAGABOND.Downtime.ActivitiesHeader"}}</h3>

  <div class="dt-mosaic">
    {{#each activityTiles}}
      {{> dtTile}}
    {{/each}}
  </div>

  <div class="dt-drawer {{#if activityOpen}}is-open{{/if}}">
    <div class="dt-drawer-inner">

      <div class="dt-pane {{#if sel.craft}}is-active{{/if}}" data-pane="craft">
        <div class="dt-controls">
          {{#if craftingEnabled}}
            <span class="dt-chip" data-tooltip="{{localize 'VAGABOND.Downtime.Have.Materials'}}"><i class="fas fa-cubes"></i> {{have.materials}}</span>
            <span class="dt-chip" data-tooltip="{{localize 'VAGABOND.Downtime.Have.ValuePerShift'}}"><i class="fas fa-hammer"></i> {{have.valuePerShift}}</span>
          {{else}}
            <span class="dt-hint">{{localize "VAGABOND.Craft.Workbench.SystemDisabled"}}</span>
          {{/if}}
          <button type="button" class="dt-go" data-action="openWorkbench" {{#unless craftingEnabled}}disabled{{/unless}}>
            <i class="fas fa-hammer"></i> {{localize "VAGABOND.Craft.Workbench.Title"}}
          </button>
        </div>
        <div class="dt-book">{{{localize "VAGABOND.Downtime.Craft.Book"}}}</div>
      </div>

      <div class="dt-pane {{#if sel.study}}is-active{{/if}}" data-pane="study">
        <div class="dt-controls">
          <span class="dt-chip" data-tooltip="{{localize 'VAGABOND.Downtime.Study.DiceTooltip'}}"><i class="fas fa-dice-d6"></i> {{studiedDice}}</span>
          <button type="button" class="dt-go" data-action="processStudy" {{#if noShifts}}disabled{{/if}}>
            <i class="fas fa-book-open"></i> {{localize "VAGABOND.Downtime.Study.Button"}}
          </button>
        </div>
        <div class="dt-book">{{{localize "VAGABOND.Downtime.Study.Book"}}}</div>
      </div>

      <div class="dt-pane {{#if sel.forage}}is-active{{/if}}" data-pane="forage">
        <div class="dt-controls">
<span class="dt-chip" data-tooltip="{{localize 'VAGABOND.Downtime.Have.SurvivalTooltip'}}"><i class="fas fa-dice-d20"></i> {{have.survival.label}} {{have.survival.difficulty}}{{#if have.survival.trained}} <i class="fas fa-star dt-trained"></i>{{/if}}</span>
          <div class="dt-seg">
            <button type="button" data-action="forageType" data-value="rations" class="{{#if (eq forageType 'rations')}}is-selected{{/if}}">{{localize "VAGABOND.Downtime.Forage.Rations"}}</button>
            <button type="button" data-action="forageType" data-value="materials" class="{{#if (eq forageType 'materials')}}is-selected{{/if}}">{{localize "VAGABOND.Downtime.Forage.Materials"}}</button>
          </div>
          <button type="button" class="dt-go" data-action="processForage" {{#if noShifts}}disabled{{/if}}
                  data-tooltip="{{localize 'VAGABOND.Downtime.SurvivalTooltip'}}">
            <i class="fas fa-dice-d20"></i> {{localize "VAGABOND.Downtime.Forage.Button"}}
          </button>
        </div>
        <div class="dt-book">{{{localize "VAGABOND.Downtime.Forage.Book"}}}</div>
      </div>

      <div class="dt-pane {{#if sel.hunt}}is-active{{/if}}" data-pane="hunt">
        <div class="dt-controls">
<span class="dt-chip" data-tooltip="{{localize 'VAGABOND.Downtime.Have.SurvivalTooltip'}}"><i class="fas fa-dice-d20"></i> {{have.survival.label}} {{have.survival.difficulty}}{{#if have.survival.trained}} <i class="fas fa-star dt-trained"></i>{{/if}}</span>
          <button type="button" class="dt-go" data-action="processHunt" {{#if noShifts}}disabled{{/if}}
                  data-tooltip="{{localize 'VAGABOND.Downtime.SurvivalTooltip'}}">
            <i class="fas fa-dice-d20"></i> {{localize "VAGABOND.Downtime.Hunt.Button"}}
          </button>
        </div>
        <div class="dt-book">{{{localize "VAGABOND.Downtime.Hunt.Book"}}}</div>
      </div>

      <div class="dt-pane {{#if sel.other}}is-active{{/if}}" data-pane="other">
        <div class="dt-controls">
          <select name="otherSkill" data-tooltip="{{localize 'VAGABOND.Downtime.Other.SkillLabel'}}">
            {{selectOptions skills selected=defaultSkill valueAttr="key" labelAttr="label"}}
          </select>
          <label class="dt-gold" data-tooltip="{{localize 'VAGABOND.Downtime.Other.GoldTooltip'}}">
            <i class="fas fa-coins"></i><input type="number" name="otherGold" value="0" min="0" step="10">
          </label>
          <span class="dt-chip" data-tooltip="{{localize 'VAGABOND.Downtime.Have.Coins'}}"><i class="fas fa-coins"></i> {{have.coins}}</span>
          <button type="button" class="dt-go" data-action="processOther" {{#if noShifts}}disabled{{/if}}>
            <i class="fas fa-dice-d20"></i> {{localize "VAGABOND.Downtime.Other.Button"}}
          </button>
        </div>
        <div class="dt-book">{{{localize "VAGABOND.Downtime.Other.Book"}}}</div>
      </div>

    </div>
  </div>

  {{!-- ============ Rest & Breather (not Downtime activities) ============ --}}
  <h3 class="dt-section">{{localize "VAGABOND.Downtime.RestHeader"}}</h3>

  <div class="dt-mosaic">
    {{#each restTiles}}
      {{> dtTile}}
    {{/each}}
  </div>

  <div class="dt-drawer {{#if restOpen}}is-open{{/if}}">
    <div class="dt-drawer-inner">

      <div class="dt-pane {{#if sel.rest}}is-active{{/if}}" data-pane="rest">
        <div class="dt-controls">
          <select name="lodgingType" data-tooltip="{{localize 'VAGABOND.Downtime.Rest.LodgingLabel'}}">
            {{selectOptions lodging selected="none" valueAttr="key" labelAttr="label"}}
          </select>
          <span class="dt-chip" data-tooltip="{{localize 'VAGABOND.Downtime.Have.Coins'}}"><i class="fas fa-coins"></i> {{have.coins}}</span>
          <button type="button" class="dt-go" data-action="processRest">
            <i class="fas fa-bed"></i> {{localize "VAGABOND.Downtime.Rest.Button"}}
          </button>
        </div>
        <div class="dt-book">{{{localize "VAGABOND.Downtime.Rest.Book"}}}</div>
      </div>

      <div class="dt-pane {{#if sel.breather}}is-active{{/if}}" data-pane="breather">
        <div class="dt-controls">
          <span class="dt-chip" data-tooltip="{{localize 'VAGABOND.Downtime.Breather.HealTooltip'}}"><i class="fas fa-heart"></i> +{{might}}</span>
          <span class="dt-chip {{#unless rations}}is-zero{{/unless}}" data-tooltip="{{localize 'VAGABOND.Downtime.Breather.RationsTooltip'}}"><i class="fas fa-drumstick-bite"></i> {{rations}}</span>
          <button type="button" class="dt-go" data-action="processBreather" {{#if breatherUsed}}disabled data-tooltip="{{localize 'VAGABOND.Downtime.Breather.AlreadyUsed'}}"{{/if}}>
            <i class="fas fa-heart"></i> {{localize "VAGABOND.Downtime.Breather.Button"}}
          </button>
        </div>
        <div class="dt-book">{{{localize "VAGABOND.Downtime.Breather.Book"}}}</div>
      </div>

    </div>
  </div>
</div>
