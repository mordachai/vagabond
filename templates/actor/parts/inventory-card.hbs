{{! Inventory Card - Each item is a separate instance }}
<div
  class='inventory-card draggable
         {{#if equipped}}equipped{{/if}}
         {{#if isSlotZero}}{{#unless isFullZeroStack}}slot-zero{{/unless}}{{/if}}
         {{#if item.flags.vagabond.mix.inert}}is-inert{{/if}}
         {{#if (eq item.system.quantity 0)}}is-depleted{{/if}}'
  data-item-id='{{item._id}}'
  data-uuid='{{item.uuid}}'
  data-item-slots='{{item.system.slots}}'
  data-item-type='{{item.type}}'
  data-grid-position='{{gridPosition}}'
  data-hud-tip='{{tooltip}}'
  data-hud-tip-duration='1500'
  data-is-slot-zero='{{isSlotZero}}'
  data-display-number='{{displayNumber}}'
  style='grid-column: span {{#if (eq totalSlots 0)}}1{{else}}{{totalSlots}}{{/if}};'
  draggable='true'
>
  <img src='{{item.img}}' alt='{{item.name}}' class='item-image' />
  <div class='item-name-display'>{{item.name}}</div>
  {{#if item.flags.vagabond.mix.inert}}<div class='item-inert-badge'>{{localize 'VAGABOND.Craft.Mix.InertBadge'}}</div>{{/if}}
  {{#if usesPips.length}}
    <div class='item-uses-pips'>
      {{#each usesPips as |pip|}}
        <i
          class='fa-solid fa-circle uses-pip {{#if pip.filled}}filled{{else}}empty{{/if}}'
          data-action='usePip'
          data-item-uuid='{{../item.uuid}}'
          data-pip-index='{{pip.index}}'
        ></i>
      {{/each}}
    </div>
  {{/if}}
  {{#if showQty}}
    <div
      class='item-qty-badge {{#unless item.system.quantity}}empty{{/unless}}'
      data-action='adjustQuantity'
      data-item-id='{{item._id}}'
      data-tooltip='{{localize "VAGABOND.ContextMenu.QuantityHint"}}: L +1 · R −1'
    >×{{item.system.quantity}}</div>
  {{/if}}
  {{#if disguiseEye}}
    {{! GM only (ItemDisguise.toggle): open eye = disguised (click reveals), slashed = revealed (click disguises) }}
    <button
      type='button'
      class='disguise-marker {{#if disguiseEye.on}}is-on{{/if}}'
      data-action='toggleItemDisguise'
      data-item-id='{{item._id}}'
      data-tooltip='{{#if disguiseEye.on}}{{localize "VAGABOND.Item.Disguise.ToggleReveal"}}{{else}}{{localize "VAGABOND.Item.Disguise.ToggleHide"}}{{/if}}'
    ><i class='fa-solid {{#if disguiseEye.on}}fa-eye{{else}}fa-eye-slash{{/if}}'></i></button>
  {{/if}}
  {{#if requiresBound}}
    {{! Curse tip rides the card's own hud-tip controller (a native data-tooltip fought the card tip for game.tooltip) }}
    <div class='bound-marker {{#if curse}}is-cursed{{/if}}' {{#if curse}}data-hud-tip-html='{{curse.tooltip}}' data-hud-tip-duration='3000'{{/if}}>
      {{#if bound}}
        <i class='fa-solid fa-diamond bound {{#if curse}}cursed{{/if}}'></i>
      {{else}}
        <i class='fa-solid fa-diamond unbound {{#if curse}}cursed{{/if}}'></i>
      {{/if}}
    </div>
  {{/if}}
</div>
